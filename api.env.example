# Secrets for docker-compose.api.yml, loaded via env_file. Copy this file to
# `api.env` on the VPS (same directory as docker-compose.api.yml) and fill in
# the real key. `api.env` is gitignored — never commit it.
#
#   cp api.env.example api.env
#   docker compose -f docker-compose.api.yml up -d --build

# From resend.com (free tier). Required to actually send run-summary emails —
# without it, sending is a safe logged no-op (see functions/src/runs/runSummaryEmail.ts).
RESEND_API_KEY=re_xxx
