# Secrets for docker-compose.api.yml, loaded via env_file. Copy this file to
# `api.env` on the VPS (same directory as docker-compose.api.yml) and fill in
# the real key. `api.env` is gitignored — never commit it.
#
#   cp api.env.example api.env
#   docker compose -f docker-compose.api.yml up -d --build

# From resend.com (free tier). Required to actually send run-summary emails —
# without it, sending is a safe logged no-op (see functions/src/runs/runSummaryEmail.ts).
RESEND_API_KEY=re_xxx

# ── The marketing CMS's GitHub sign in (DEPLOY.md §12E) ──────────────────────
# From the GitHub OAuth application (Settings → Developer settings → OAuth Apps).
# Its "Authorization callback URL" must be exactly
# https://api.rush-point.com/oauth/callback — GitHub compares it byte for byte and
# refuses the exchange otherwise, with an error the popup can only report vaguely.
#
# The secret belongs HERE and not in docker-compose.api.yml: that file is in git.
# With either value missing, /oauth answers 503 and says the editor is not
# connected yet — the site, the blog and every gate are unaffected.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
