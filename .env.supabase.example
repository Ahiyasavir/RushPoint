# RushPoint — local Supabase environment (change: supabase-local-dev)
# =============================================================================
# Copy this file to `.env.supabase` (gitignored) before the first run:
#
#     cp .env.supabase.example .env.supabase
#     node scripts/supabase-dev.mjs
#
# The launcher refuses to start without it and names exactly which keys are absent.
#
# ⚠️  EVERY SECRET BELOW IS A PUBLIC, WELL-KNOWN LOCAL-ONLY DEMO VALUE. ⚠️
# They are the keys published in the supabase/supabase self-hosting repo, which means
# they are in every search index on earth. They exist so a fresh checkout boots with
# zero setup. They are NOT credentials.
#
#   • NEVER copy any of these into a hosted Supabase project, a CI secret, a deploy
#     env, or any machine reachable from the internet.
#   • The stack binds every port to 127.0.0.1 (see docker-compose.supabase.yml), so
#     these keys are only usable from this machine. Do not "helpfully" change that
#     binding to 0.0.0.0 — with these keys that publishes an unauthenticated
#     service_role endpoint to the local network.
#   • Production keys come from the Supabase dashboard and belong in the deploy
#     environment, never in a committed file.
# =============================================================================


# ── Postgres ─────────────────────────────────────────────────────────────────
# The password every internal service authenticates with (supabase_auth_admin,
# authenticator, supabase_storage_admin, …). It is baked into the data volume on
# first boot, so changing it later needs `--reset` (or an ALTER ROLE by hand).
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


# ── JWT ──────────────────────────────────────────────────────────────────────
# The HS256 secret GoTrue signs with and PostgREST/Storage/Realtime verify against.
# MUST be at least 32 characters — a shorter secret produces tokens PostgREST rejects
# with an opaque 401 that looks exactly like a broken RLS policy. The launcher checks
# the length so you find out in one second instead of one afternoon.
#
# ANON_KEY and SERVICE_ROLE_KEY are JWTs SIGNED WITH THIS EXACT SECRET. Change the
# secret and you must regenerate both, or nothing authenticates. Keep all three
# together.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# role: anon — what the browser gets before sign-in. Safe to ship to a client;
# every protection is RLS behind it. (LOCAL-ONLY demo key.)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# role: service_role — BYPASSES ROW LEVEL SECURITY ENTIRELY. This is the Supabase
# equivalent of the Firebase Admin SDK: server-side only, never in a client bundle,
# never in a VITE_* variable (Vite inlines those into shipped JavaScript).
# (LOCAL-ONLY demo key.)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q


# ── URLs ─────────────────────────────────────────────────────────────────────
# SUPABASE_PUBLIC_URL is what Studio and GoTrue hand to the BROWSER, so it must be a
# host-reachable address (127.0.0.1:<kong port>), never the internal `http://kong:8000`.
# The loopback literal, not `localhost`: the Windows IPv6 mismatch already bit the
# Firebase emulator wiring (see CLAUDE.md).
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321

# Where GoTrue sends people after email confirmation / OAuth. play-web in dev.
SITE_URL=http://127.0.0.1:5181

# Every other origin GoTrue may redirect back to. creator-web (5180) + play-web (5181),
# each under both hostnames because the two dev servers are reached both ways.
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5180,http://127.0.0.1:5181,http://localhost:5180,http://localhost:5181


# ── Realtime ─────────────────────────────────────────────────────────────────
# SECRET_KEY_BASE is the Phoenix cookie/session signing key; it must be ≥64 chars or
# the container exits at boot with a Plug error. DB_ENC_KEY encrypts stored tenant
# credentials and must be exactly 16 characters. Both LOCAL-ONLY.
REALTIME_SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
REALTIME_DB_ENC_KEY=supabaserealtime


# ── PostgREST ────────────────────────────────────────────────────────────────
# Schemas exposed over REST. `storage` is required for the Storage API; add a new
# schema here or PostgREST returns 404 for every table in it.
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_LOG_LEVEL=error
GOTRUE_LOG_LEVEL=info


# ── Studio ───────────────────────────────────────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=RushPoint
STUDIO_DEFAULT_PROJECT=RushPoint Local


# ── Ports (informational — DO NOT SET THESE HERE) ────────────────────────────
# SUPABASE_KONG_PORT / _DB_PORT / _STUDIO_PORT / _AUTH_PORT / _REST_PORT /
# _REALTIME_PORT / _STORAGE_PORT and COMPOSE_PROJECT_NAME are computed by
# scripts/lib/supabaseEnv.mjs and injected by the launcher. Setting them here does
# nothing (the launcher's values win) — it only creates a second, stale copy of the
# port block that will eventually disagree with the real one.
#
#   kong 54321 · db 54322 · studio 54323 · auth 54324 · rest 54325 ·
#   realtime 54326 · storage 54327
#
# To run a SECOND stack beside a live one, set the offset in your SHELL, not here:
#
#   RUSHPOINT_SUPABASE_PORT_OFFSET=1000 node scripts/supabase-dev.mjs
#
# That shifts every port by 1000 and gives the stack its own compose project and its
# own volumes. Why a multiple of 1000, and why this block can never collide with the
# Firebase emulator suite on 4000/5001/8080/9099/9199 — see the header of
# docker-compose.supabase.yml and the proof in scripts/test-supabase-env.ts §5.


# ── Application wiring (for reference) ───────────────────────────────────────
# When packages/data and the apps are pointed at Supabase, the client-side values are:
#
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<the ANON_KEY above>
#
# Never a VITE_ prefix on SERVICE_ROLE_KEY or JWT_SECRET — Vite inlines VITE_* into
# the shipped bundle, so that would publish an RLS-bypassing key to every participant.
