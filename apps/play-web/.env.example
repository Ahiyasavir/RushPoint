# ═══════════════════════════════════════════════════════════
# RushPoint Participant app (play-web) — build-time env.
# Copy to apps/play-web/.env (gitignored). VITE_* values are embedded in the
# built bundle — they are PUBLIC by design; never put secrets here.
# In local dev these are optional (emulator-safe defaults are baked in).
# ═══════════════════════════════════════════════════════════

# ── Firebase Web config — Console → Project settings → Your apps (Web) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=rushpoint-pwa-7daaa
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── App Check (optional; OFF until the app is registered) ────────────────────
# reCAPTCHA v3 site key — Console → App Check → Apps → register this web app.
# LEAVE BLANK to keep App Check completely inactive (the current, safe state):
# with no key the client never attaches App Check at all. It is also ALWAYS
# skipped in dev / --mode playtest builds, so the emulator + e2e suites are
# unaffected either way.
VITE_APP_CHECK_SITE_KEY=
# Server-side treatment of a request with no valid App Check token:
#   off      — ignore (default; the ONLY safe value before every real app is
#              registered and shipping tokens — enforcing early locks out users)
#   monitor  — log the misses in Cloud Logging, still serve the request
#   enforce  — reject the request
# Anything unrecognised is read as "off" on purpose.
VITE_APP_CHECK_ENFORCE=off

# ── Map provider (optional) ──────────────────────────────────────────────────
# MapTiler "outdoor" style — free tier, no card: https://cloud.maptiler.com
# Without it, maps fall back to keyless OpenTopoMap tiles.
VITE_MAPTILER_KEY=

# ── Crash reporting (optional) ────────────────────────────────────────────────
# Set a Sentry DSN to light up src/services/telemetry.ts. Absent ⇒ console-only.
# Requires `npm i @sentry/browser` in this workspace to activate.
# VITE_SENTRY_DSN=
