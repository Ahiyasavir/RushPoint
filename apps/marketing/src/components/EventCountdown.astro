---
/**
 * The countdown to RushPoint Live (change: rushpoint-live-urgency).
 *
 * WHY IT IS ALLOWED TO EXIST. A countdown is the most over-used and most
 * distrusted device in marketing, and the measured numbers say why: across
 * published tests, a timer tied to a real deadline lifts conversion about 9%
 * while a fabricated or resetting one COSTS about 3%. The dividing line is
 * whether a visitor who stops to check would find us telling the truth. Ours
 * counts to one evening, in one city, on a date printed beside it — so it earns
 * the lift honestly. Everything below exists to keep it that way.
 *
 * THE DATE IS RENDERED IN THE MARKUP, THE DIGITS ARE NOT. This is a static site,
 * so anything baked in at build time is a lie by the second day. The numbers are
 * therefore filled in by script, and what a visitor sees before that (or with
 * scripting off, or on a device whose clock is wrong) is the date itself — which
 * is the real information. The countdown is the decoration; the date is the fact.
 *
 * Every verdict comes from `countdownAt` in utils/liveEvent.ts, which is pure,
 * total, and gated by scripts/test-live-event-countdown.ts.
 */
import { Icon } from 'astro-icon/components';
import {
  LIVE_EVENT_AT,
  LIVE_EVENT_CITY_HE,
  LIVE_EVENT_DATE_HE,
  LIVE_EVENT_DAY_HE,
  MAX_PLAUSIBLE_LEAD_MS,
} from '~/utils/liveEvent';

export interface Props {
  /** `dark` sits on the near-black band; `light` on the page surface. */
  tone?: 'dark' | 'light';
  class?: string;
}

const { tone = 'dark', class: className = '' } = Astro.props;

const cell = tone === 'dark' ? 'border-white/10 bg-white/[0.06] text-[#faf7f2]' : 'border-line bg-page text-heading';
const label = tone === 'dark' ? 'text-[#b6ada1]' : 'text-muted';

/** Largest unit first in READING order; the container is RTL, so days sit right. */
const UNITS = [
  { key: 'days', label: 'ימים' },
  { key: 'hours', label: 'שעות' },
  { key: 'minutes', label: 'דקות' },
  { key: 'seconds', label: 'שניות' },
];
---

<div class={className} data-countdown data-event-at={LIVE_EVENT_AT} data-max-lead={MAX_PLAUSIBLE_LEAD_MS}>
  {/* The fact, always present, never dependent on a clock or on scripting. */}
  <p class={`flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-base font-bold ${tone === 'dark' ? 'text-[#faf7f2]' : 'text-heading'}`}>
    <Icon name="tabler:calendar-event" class="h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
    <span>{LIVE_EVENT_DAY_HE}, {LIVE_EVENT_DATE_HE}, בערב</span>
    <span class={label}>·</span>
    <span>{LIVE_EVENT_CITY_HE}</span>
  </p>

  {/*
    Hidden until the script has a number it believes. Starting visible and empty
    would flash four zeros on every load, which reads as "the race already
    happened" for the one frame it is on screen.
  */}
  <div class="mt-4 hidden" data-countdown-clock>
    <ul class="flex items-center justify-center gap-2 sm:gap-3" dir="rtl">
      {
        UNITS.map((unit) => (
          <li class={`min-w-[4.25rem] rounded-xl border px-2 py-2.5 text-center sm:min-w-[5rem] ${cell}`}>
            {/*
              `tabular-nums` so the digits do not jitter the layout every second
              as glyph widths change — a countdown that visibly twitches reads as
              cheap, which is the opposite of what it is here to do.
            */}
            <div class="font-heading text-2xl font-black leading-none tabular-nums sm:text-3xl" data-unit={unit.key}>
              00
            </div>
            <div class={`mt-1.5 text-[11px] sm:text-xs ${label}`}>{unit.label}</div>
          </li>
        ))
      }
    </ul>
    {/*
      One polite live region for assistive technology, updated once a minute
      rather than once a second. A per-second announcement would make the page
      unusable with a screen reader, and the seconds are decoration anyway.
    */}
    <p class="sr-only" role="status" aria-live="polite" data-countdown-announce></p>
  </div>

  {/* Shown only once the evening has arrived. */}
  <p class="mt-4 hidden text-lg font-black text-primary" data-countdown-started>המירוץ יצא לדרך</p>
</div>

<script>
  // Page local, no framework. Every countdown on the page is driven by one
  // interval: two independent timers can drift apart by a second and show
  // different numbers on the same screen, which is exactly the kind of small
  // wrongness that makes a visitor stop believing the rest of the page.
  import { countdownAt } from '~/utils/liveEvent';

  const roots = Array.from(document.querySelectorAll('[data-countdown]'));

  function render() {
    const now = Date.now();
    for (const root of roots) {
      const eventAt = Number(root.getAttribute('data-event-at'));
      const verdict = countdownAt(now, eventAt);

      const clock = root.querySelector('[data-countdown-clock]');
      const started = root.querySelector('[data-countdown-started]');
      if (!clock || !started) continue;

      // `unknown` deliberately shows NEITHER: the date above stays, alone. A
      // device whose clock is wrong gets the fact and no invented number.
      clock.classList.toggle('hidden', verdict.state !== 'counting');
      started.classList.toggle('hidden', verdict.state !== 'started');

      if (verdict.state !== 'counting') continue;

      // Typed as the literal union rather than string[], so indexing the verdict
      // is checked and a renamed field fails the build instead of the page.
      const UNIT_KEYS = ['days', 'hours', 'minutes', 'seconds'] as const;
      for (const key of UNIT_KEYS) {
        const cell = clock.querySelector(`[data-unit="${key}"]`);
        // Days are not padded — "7" is a truer shape than "07" for a count that
        // will reach three digits at the far end and one at the near end.
        if (cell) cell.textContent = key === 'days' ? String(verdict.days) : String(verdict[key]).padStart(2, '0');
      }

      const announce = clock.querySelector('[data-countdown-announce]');
      if (announce) {
        const text = `נותרו ${verdict.days} ימים ו${verdict.hours} שעות למירוץ`;
        // Only rewrite when the MINUTE-level text actually changed, so the live
        // region does not re-announce every second.
        if (announce.textContent !== text) announce.textContent = text;
      }
    }
  }

  render();
  const timer = window.setInterval(render, 1000);

  // A backgrounded tab is throttled, so the first frame after it returns can be
  // stale by minutes. Re-render on the way back rather than waiting for the tick.
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) render();
  });

  window.addEventListener('pagehide', () => window.clearInterval(timer));
</script>
