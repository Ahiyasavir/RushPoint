---
/**
 * The hero's field map: contours, a route that draws itself, four stations.
 *
 * WHY IT IS DRAWN RATHER THAN FILMED. This sits in the hero, which means it sits
 * on top of the page's largest contentful paint. A screen capture is a video
 * file, a poster image and a decoder; this is a few kilobytes of markup already
 * inside the document, so it costs no request at all and it is sharp on every
 * display. `scripts/test-marketing-home-cro.ts` holds that line: no <img>, no
 * <video>, no `src`, no `url()` in this file. Somebody will eventually want to
 * "just use a screenshot" here, and the honest place for one is the optional
 * `heroClip` content field, which swaps the whole frame rather than smuggling a
 * request into the map.
 *
 * WHY MOTION IS OPT IN. Every animation below lives inside
 * `@media (prefers-reduced-motion: no-preference)`, and the STATIC state is the
 * finished one: full route, every station, badge showing. So a visitor who asked
 * their system for less motion is not shown an animation that then gets undone,
 * they are shown the end of it, immediately, and nothing moves. Written the
 * other way round, as `@media (reduce) { animation: none }`, every new animation
 * would move for everyone until somebody remembered the second query.
 *
 * DECORATIVE. The visible challenge line beside this in the hero says what it
 * means, so the whole thing is `aria-hidden`. A screen reader hearing "map,
 * route, pin, pin, pin, pin, plus forty" would be told less, at greater length.
 *
 * Change: marketing-home-cro-redesign.
 */
export interface Props {
  /** The number on the score chip. A number, so it needs no translation. */
  points?: number;
  class?: string;
}

const { points = 40, class: className = '' } = Astro.props;

/**
 * One closed contour ring, drawn around its own origin so it can be placed and
 * scaled. Real contours are irregular: an ellipse reads as a target, and a
 * target reads as a diagram rather than as ground.
 */
const RING = 'M0 -26C22 -30 40 -14 38 4C36 22 16 30 -4 27C-26 24 -40 8 -36 -8C-32 -22 -16 -22 0 -26Z';

/** Where the hills are, and how many rings each one gets. */
const CONTOURS = [
  { cx: 84, cy: 166, rings: [1, 1.5, 2.05, 2.65, 3.3] },
  { cx: 238, cy: 452, rings: [1, 1.55, 2.15, 2.8] },
  { cx: 126, cy: 574, rings: [1.2, 1.95] },
];

/** The four stations, in the order a team is routed through them. */
const STATIONS = [
  { x: 72, y: 512 },
  { x: 152, y: 404 },
  { x: 98, y: 272 },
  { x: 214, y: 152 },
];

/** The walk between them. Curved, because nobody crosses a park in straight lines. */
const ROUTE =
  'M72 512C104 486 132 452 152 404C172 356 116 314 98 272C80 230 152 202 214 152';
---

<div class={`rp-fieldmap ${className}`} aria-hidden="true">
  <svg viewBox="0 0 300 620" preserveAspectRatio="xMidYMid slice" focusable="false">
    <rect x="0" y="0" width="300" height="620" class="rp-land"></rect>

    {/* Streets. Three of them, faint: enough to say "a place", not a street map. */}
    <g class="rp-street">
      <path d="M-20 236L320 176"></path>
      <path d="M-20 468L320 396"></path>
      <path d="M188 -20L236 640"></path>
    </g>

    {/* Contours. */}
    <g class="rp-contour">
      {
        CONTOURS.map(({ cx, cy, rings }) =>
          rings.map((scale) => (
            <path d={RING} transform={`translate(${cx} ${cy}) scale(${scale})`} />
          )),
        )
      }
    </g>

    {/* The planned route, always fully visible: this is where the team is going. */}
    <path d={ROUTE} class="rp-route-guide"></path>

    {/* The distance already walked, drawn on top of it. */}
    <path d={ROUTE} class="rp-route-line" pathLength="1"></path>

    {/* The stations. The halo is the only part that moves. */}
    {
      STATIONS.map(({ x, y }, i) => (
        <g transform={`translate(${x} ${y})`}>
          <circle r="15" class={`rp-pin-halo rp-pin-halo-${i + 1}`} />
          <circle r="9" class="rp-pin-body" />
          <circle r="3.4" class="rp-pin-core" />
        </g>
      ))
    }

    {/* The score chip: the thing a team actually feels when a station lands.
        Placed by an OUTER group and animated on an inner one, so the entrance
        transform never has to restate the position and cannot drift from it. */}
    <g transform="translate(168 74)">
      <g class="rp-badge">
        <rect x="0" y="0" width="104" height="42" rx="21" class="rp-badge-fill"></rect>
        <text x="52" y="29" class="rp-badge-text">+{points}</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .rp-fieldmap {
    width: 100%;
    height: 100%;
    /* The palette, in one place. Everything below is a var so the dark override
       is four lines rather than a second copy of the whole stylesheet. */
    --rp-land: #fbf4e9;
    --rp-ink: rgb(90 70 45 / 20%);
    --rp-ink-soft: rgb(90 70 45 / 11%);
    --rp-brand: #ff5722;
    --rp-on-brand: #ffffff;
    --rp-pin-ring: #fffcf7;
  }

  /* `:global(.dark)` because the theme class sits on an ancestor OUTSIDE this
     component: a scoped selector would look for the component's own hash on it
     and match nothing. */
  :global(.dark) .rp-fieldmap {
    --rp-land: #1a1611;
    --rp-ink: rgb(240 236 229 / 20%);
    --rp-ink-soft: rgb(240 236 229 / 10%);
    --rp-pin-ring: #14110d;
  }

  .rp-fieldmap svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .rp-land {
    fill: var(--rp-land);
  }

  .rp-street path {
    fill: none;
    stroke: var(--rp-ink-soft);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .rp-contour path {
    fill: none;
    stroke: var(--rp-ink);
    stroke-width: 1.1;
  }

  .rp-route-guide {
    fill: none;
    stroke: var(--rp-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
  }

  .rp-route-line {
    fill: none;
    stroke: var(--rp-brand);
    stroke-width: 4.5;
    stroke-linecap: round;
    /* pathLength="1" on the element, so one dash covers the whole route
       whatever its real length is. The static state is DRAWN. */
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .rp-pin-body {
    fill: var(--rp-brand);
    stroke: var(--rp-pin-ring);
    stroke-width: 3;
  }
  .rp-pin-core {
    fill: var(--rp-on-brand);
  }
  .rp-pin-halo {
    fill: var(--rp-brand);
    /* Invisible when nothing is moving: a halo is the animation, not a feature
       of the pin, so a still map should not carry four orange smudges. */
    opacity: 0;
    /* WITHOUT THESE TWO the scale below is measured from the SVG viewport's
       origin rather than the circle's own centre, and the halo flies off toward
       the top left corner instead of expanding around its pin. The default
       `transform-box: view-box` is the trap: it is right for a whole drawing and
       wrong for every individual shape inside one. */
    transform-box: fill-box;
    transform-origin: center;
  }

  .rp-badge {
    /* Same reason as the halo: the entrance scales the chip about itself. */
    transform-box: fill-box;
    transform-origin: center;
  }
  .rp-badge-fill {
    fill: var(--rp-brand);
  }
  .rp-badge-text {
    fill: var(--rp-on-brand);
    font-family: var(--rp-font-display), var(--rp-font-body), system-ui, sans-serif;
    font-size: 22px;
    font-weight: 700;
    text-anchor: middle;
    /* The chip reads left to right in both languages: it is a number with a sign
       on it, not a sentence. */
    direction: ltr;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rp-route-line {
      animation: rp-route-draw 2.4s cubic-bezier(0.4, 0, 0.2, 1) 0.25s both;
    }

    .rp-pin-halo {
      animation: rp-pin-pulse 2.8s ease-out infinite;
    }
    /* Staggered, so the four stations read as a sequence a team moves through
       rather than as four things blinking together. */
    .rp-pin-halo-1 { animation-delay: 0.2s; }
    .rp-pin-halo-2 { animation-delay: 0.8s; }
    .rp-pin-halo-3 { animation-delay: 1.4s; }
    .rp-pin-halo-4 { animation-delay: 2s; }

    /* Lands as the route reaches the last station, which is the whole point of
       the chip: the score arrives when the team does. */
    .rp-badge {
      animation: rp-badge-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) 2.5s both;
    }
  }

  @keyframes rp-route-draw {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes rp-pin-pulse {
    0% { opacity: 0.45; transform: scale(0.6); }
    70% { opacity: 0; transform: scale(1.6); }
    100% { opacity: 0; transform: scale(1.6); }
  }

  @keyframes rp-badge-in {
    from { opacity: 0; transform: translateY(14px) scale(0.85); }
    to { opacity: 1; transform: none; }
  }
</style>
