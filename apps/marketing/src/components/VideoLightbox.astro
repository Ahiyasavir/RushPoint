---
/**
 * The explainer video, as a poster card that opens a real player.
 *
 * WHAT WAS WRONG BEFORE. The video was rendered by `Media.astro` as a bare
 * `<video controls preload="none">`: a still frame with the operating system's
 * own small control bar over it. That is correct markup and it reads, to a
 * visitor, as a broken embed. There is no invitation to press anything, the
 * control bar is the least branded object on the page, and a poster with no play
 * affordance looks like an image that failed to load. So people did not press
 * it, and the single best explanation of the product went unwatched.
 *
 * WHAT THIS DOES INSTEAD. The poster becomes a designed object: framed, with a
 * large brand play control, a running time, and a line saying what it is. It
 * opens a modal and plays LARGE, with sound, because by then the visitor has
 * asked for it twice.
 *
 * WHAT IT KEEPS. `Media.astro` refuses to start a video on its own, and the
 * reason written beside that refusal still holds: a video that starts by itself
 * takes over the page and spends somebody's mobile data without asking. So this
 * does not start one either. It goes further, in fact: the `<video>` has no
 * source at all until the poster is pressed, so the file is not merely unplayed,
 * it is unfetched. The gallery keeps using `Media.astro` unchanged.
 *
 * KEYBOARD AND SCREEN READER. A native `<dialog>`, opened with `showModal()`,
 * rather than a div with a class called "modal". It contains focus, it makes the
 * page behind it inert, and it closes on Escape, all without a hand rolled focus
 * trap that would be subtly wrong. Focus returns to the poster on close, so a
 * keyboard user is put back where they were rather than at the top of the
 * document. The accessible names come from `mediaLabels()` in navigation.ts,
 * beside the other control names, so a Hebrew page cannot announce an English
 * control.
 *
 * Change: marketing-home-cro-redesign.
 */
import type { MediaItem } from '~/components/Media.astro';

export interface Props {
  media: MediaItem;
  /** One line saying what the video is. Per language, from the content file. */
  label: string;
  /** Its running time, e.g. `1:30`. */
  duration: string;
  /** Accessible names for the two controls. See `mediaLabels()`. */
  labels: { playVideo: string; closeVideo: string };
  class?: string;
}

const { media, label, duration, labels, class: className = '' } = Astro.props;
---

<div class={`rp-lightbox ${className}`} data-rp-lightbox>
  <figure class="rp-figure">
    <div class="rp-frame">
      {/* Browser chrome. Decorative: it says "this is a screen" faster than any
          caption could, and it is three dots rather than a picture of a browser. */}
      <div class="rp-chrome" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <button type="button" class="rp-poster" data-rp-open aria-label={labels.playVideo}>
        {/* Empty alt on purpose: the button already has an accessible name, and
            announcing both would say the same thing twice. */}
        <img class="rp-shot" src={media.poster} alt="" loading="lazy" decoding="async" />
        <span class="rp-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.2v13.6L19 12z"></path></svg>
        </span>
        <span class="rp-duration" aria-hidden="true">{duration}</span>
      </button>
    </div>
    <figcaption class="rp-label">{label}</figcaption>
  </figure>

  <dialog class="rp-dialog" data-rp-dialog aria-label={labels.playVideo}>
    <button type="button" class="rp-close" data-rp-close aria-label={labels.closeVideo}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    {/* No `src`. It is attached when the poster is pressed, which is what makes
        "nothing is fetched until you ask" true rather than merely intended. */}
    <video
      class="rp-video"
      data-rp-video
      data-src={media.src}
      poster={media.poster}
      aria-label={media.alt}
      controls
      playsinline
      preload="none"></video>
  </dialog>
</div>

<style>
  .rp-figure {
    margin: 0;
  }

  .rp-frame {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--aw-color-bg-tint);
    border: 1px solid var(--aw-color-border);
    box-shadow: 0 18px 40px -20px rgb(20 17 13 / 35%);
  }

  .rp-chrome {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--aw-color-border);
  }
  .rp-chrome span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background: var(--aw-color-border);
  }

  .rp-poster {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Declared rather than inherited from the image, so the frame reserves its
       space before the poster has loaded and the hero does not jump. */
    aspect-ratio: 16 / 9;
  }

  .rp-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rp-play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    /* A logical inset with a physical translate is a trap in RTL: the element is
       placed from the right edge and then pulled further right. The RTL page
       needs the mirrored pull. */
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    background: #ff5722;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 24px -6px rgb(255 87 34 / 60%);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  :global([dir='rtl']) .rp-play {
    transform: translate(50%, -50%);
  }

  .rp-play svg {
    width: 2rem;
    height: 2rem;
    fill: #ffffff;
    /* The triangle points the way the language reads. */
    transform: none;
  }
  :global([dir='rtl']) .rp-play svg {
    transform: scaleX(-1);
  }

  .rp-poster:hover .rp-play,
  .rp-poster:focus-visible .rp-play {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow: 0 12px 30px -6px rgb(255 87 34 / 70%);
  }
  :global([dir='rtl']) .rp-poster:hover .rp-play,
  :global([dir='rtl']) .rp-poster:focus-visible .rp-play {
    transform: translate(50%, -50%) scale(1.08);
  }

  .rp-duration {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-end: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    /* Its own dark chip rather than the page palette: it sits on a photograph,
       whose brightness nothing here controls. */
    background: rgb(20 17 13 / 78%);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    direction: ltr;
  }

  .rp-label {
    margin-block-start: 0.85rem;
    text-align: center;
    font-size: 0.95rem;
    color: var(--aw-color-text-muted);
  }

  .rp-dialog {
    width: min(94vw, 68rem);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .rp-dialog::backdrop {
    background: rgb(20 17 13 / 82%);
  }

  .rp-video {
    width: 100%;
    max-height: 86vh;
    display: block;
    border-radius: 1rem;
    background: #14110d;
  }

  .rp-close {
    position: absolute;
    inset-block-start: -3rem;
    inset-inline-end: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 25%);
    background: rgb(20 17 13 / 70%);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .rp-close svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke: #ffffff;
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
  }

  /* On a short screen there is no room above the player for the dismiss, and a
     control the visitor cannot reach is the one thing a modal must never have. */
  @media (max-height: 34rem) {
    .rp-close {
      inset-block-start: 0.5rem;
      inset-inline-end: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-play {
      transition: none;
    }
  }
</style>

<script>
  // Dependency free and defensive, like the other islands on this page: a thrown
  // error here would leave a dead card in the middle of the hero. Anything
  // missing means the poster simply stays a picture, which is the state the page
  // had before this component existed.
  function initLightbox(root: HTMLElement): void {
    const dialog = root.querySelector<HTMLDialogElement>('[data-rp-dialog]');
    const video = root.querySelector<HTMLVideoElement>('[data-rp-video]');
    const opener = root.querySelector<HTMLButtonElement>('[data-rp-open]');
    const closer = root.querySelector<HTMLButtonElement>('[data-rp-close]');
    if (!dialog || !video || !opener) return;

    // `showModal` is what brings focus containment, page inertness and Escape.
    // Without it this is a div with a high z-index, and shipping that silently
    // would be worse than shipping the plain poster.
    if (typeof dialog.showModal !== 'function') return;

    opener.addEventListener('click', () => {
      const src = video.dataset.src;
      if (src && video.getAttribute('src') !== src) video.setAttribute('src', src);
      dialog.showModal();
      // Started by a click, so sound is allowed and expected. A rejected promise
      // here is a browser declining, not an error worth surfacing.
      void video.play().catch(() => {});
    });

    /**
     * Stop playing and let go of the file. Idempotent on purpose: it is reached
     * from four routes below and calling it twice must be free.
     */
    const teardown = () => {
      video.pause();
      // Dropping the source stops the download of a video nobody is watching any
      // more. `load()` is what makes the element actually let go of it.
      video.removeAttribute('src');
      video.load();
    };

    const dismiss = () => {
      // BEFORE the close, not after it, and this ordering is the whole lesson.
      // The obvious implementation hangs teardown off the dialog's `close` event
      // alone, which reads as elegant: one listener, every route. Measured in a
      // real browser, the dialog closed and the video kept playing, audible, with
      // nothing on screen to pause it, because that one event did not fire. A
      // modal that hides a playing video is the worst failure this component has,
      // so the teardown does not depend on any single event reaching us.
      teardown();
      if (dialog.open) dialog.close();
      // Back to where they were. `showModal` restores focus itself in a browser
      // that implements it fully; this makes it true in one that does not.
      opener.focus();
    };

    closer?.addEventListener('click', dismiss);

    // A press on the backdrop lands on the dialog itself, since the player and
    // the dismiss are children. Anything inside must not close it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dismiss();
    });

    // Escape, handled three ways for the same reason as above: `cancel` fires
    // before a native dismiss, `close` after any dismiss, and the key itself is
    // the backstop if neither arrives. The guard inside `dismiss` makes the
    // overlap harmless.
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') dismiss();
    });
    dialog.addEventListener('cancel', teardown);
    dialog.addEventListener('close', () => {
      teardown();
      opener.focus();
    });
  }

  const boot = () => {
    document.querySelectorAll<HTMLElement>('[data-rp-lightbox]').forEach((el) => {
      if (el.dataset.rpBooted) return;
      el.dataset.rpBooted = '1';
      try {
        initLightbox(el);
      } catch {
        /* The poster stays a picture. */
      }
    });
  };
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
