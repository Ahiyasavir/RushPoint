---
/**
 * Contour lines behind a section.
 *
 * WHY. Every section of this page sat on one flat warm colour, and a flat colour
 * is what makes a page read as a template: there is nothing behind the words, so
 * the words are the only thing the eye has. This puts ground behind them, and
 * the ground is the product's own subject, a place with terrain in it.
 *
 * Drawn, not photographed, and at an opacity where it registers as texture
 * rather than as a picture. It costs no request, scales to any viewport, and
 * carries no meaning, so it is `aria-hidden` and cannot be tabbed to or read.
 *
 * Change: marketing-home-cro-redesign.
 */
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/** The same organic ring the hero map uses, so the two read as one drawing. */
const RING = 'M0 -26C22 -30 40 -14 38 4C36 22 16 30 -4 27C-26 24 -40 8 -36 -8C-32 -22 -16 -22 0 -26Z';

/** Scattered off centre. Concentric rings placed symmetrically read as a target. */
const HILLS = [
  { cx: 120, cy: 120, rings: [1.4, 2.2, 3.1, 4.1, 5.2] },
  { cx: 760, cy: 90, rings: [1.2, 2, 2.9, 3.9] },
  { cx: 980, cy: 380, rings: [1.5, 2.4, 3.4, 4.5, 5.7] },
  { cx: 330, cy: 430, rings: [1.3, 2.1, 3] },
];
---

<div class={`rp-topo ${className}`} aria-hidden="true">
  <svg viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" focusable="false">
    {
      HILLS.map(({ cx, cy, rings }) =>
        rings.map((scale) => <path d={RING} transform={`translate(${cx} ${cy}) scale(${scale})`} />),
      )
    }
  </svg>
</div>

<style>
  .rp-topo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    /* Behind the section's own content but still inside its stacking context, so
       it cannot slide under a neighbouring section's background. */
    z-index: 0;
  }

  .rp-topo svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .rp-topo path {
    fill: none;
    stroke: rgb(90 70 45);
    stroke-width: 1.2;
    /* Low enough that nobody reads it as a diagram, high enough that the page
       stops looking like an empty sheet. */
    opacity: 0.07;
  }

  :global(.dark) .rp-topo path {
    stroke: rgb(240 236 229);
    opacity: 0.06;
  }
</style>
