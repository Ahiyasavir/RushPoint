---
/**
 * The "build log" series rail.
 *
 * A devlog post is one entry in an ongoing series, and a reader who lands on
 * part three has no way to find parts one, two and four. This renders the whole
 * series as a numbered strip with the current entry marked, so every post in the
 * series links to every other one.
 *
 * It is DATA driven, not a hand-kept list: it reads the published posts sharing
 * this post's category, oldest first. Publish a part five and it appears here on
 * the next build with no edit. Fewer than two entries and it renders nothing,
 * because a "series" of one is just a post.
 *
 * No script: the current entry is decided at build time from the slug.
 */
import { publishedPosts, pathOf } from '~/utils/posts';
import type { Language } from '~/utils/i18n';

interface Props {
  language: Language;
  currentSlug: string;
  category: string;
}

const { language, currentSlug, category } = Astro.props;

const series = (await publishedPosts(language))
  .filter((post) => post.data.category === category)
  .sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf());

const dateFormat = new Intl.DateTimeFormat(language === 'he' ? 'he-IL' : 'en-GB', {
  day: 'numeric',
  month: 'short',
});

const heading = language === 'he' ? 'הסדרה' : 'The series';
---

{
  series.length > 1 && (
    <nav
      class="not-prose my-10 rounded-2xl border border-gray-200 bg-gray-50 p-5 dark:border-slate-700 dark:bg-slate-800/50"
      aria-label={heading}
    >
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-muted dark:text-slate-400">{heading}</p>
      <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {series.map((post, index) => {
          const isCurrent = post.data.slug === currentSlug;
          return (
            <li>
              <a
                href={pathOf(post)}
                aria-current={isCurrent ? 'step' : undefined}
                class:list={[
                  'flex h-full items-start gap-3 rounded-xl p-3 transition',
                  isCurrent
                    ? 'bg-white shadow-sm ring-1 ring-secondary/30 dark:bg-slate-900'
                    : 'hover:bg-white dark:hover:bg-slate-900',
                ]}
              >
                <span
                  class:list={[
                    'mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full text-xs font-bold',
                    isCurrent ? 'bg-secondary text-white' : 'bg-gray-200 text-muted dark:bg-slate-700 dark:text-slate-300',
                  ]}
                >
                  {index + 1}
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-snug">{post.data.title}</span>
                  <time
                    datetime={post.data.publishDate.toISOString()}
                    class="mt-0.5 block text-xs text-muted dark:text-slate-400"
                  >
                    {dateFormat.format(post.data.publishDate)}
                  </time>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
