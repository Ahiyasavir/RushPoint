---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { LANGUAGES, alternatesFor, pageUrl, OG_LOCALE, type Language } from '~/utils/i18n';
import { storyCopy } from '~/copy/story';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const language = Astro.params.lang as Language;
const t = storyCopy[language];

const metadata = {
  title: t.title,
  description: t.description,
  canonical: pageUrl(language, 'story'),
  openGraph: { url: pageUrl(language, 'story'), locale: OG_LOCALE[language], type: 'article' },
};
---

<PageLayout metadata={metadata} language={language} alternates={alternatesFor('story')}>
  <HeroText title={t.headline} subtitle={t.intro} />

  <section class="px-4 py-8 sm:px-6 mx-auto max-w-3xl lg:px-8 lg:py-12">
    {
      t.sections.map((section) => (
        <article class="mb-10">
          <h2 class="text-2xl font-bold tracking-tight mb-4">{section.title}</h2>
          {section.body.map((paragraph) => (
            <p class="mb-4 text-muted dark:text-slate-400 text-lg leading-relaxed">{paragraph}</p>
          ))}
        </article>
      ))
    }
    <p class="text-lg leading-relaxed font-medium">{t.closing}</p>
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: t.action, href: 'https://creator.rush-point.com', target: '_blank' },
    ]}
  />
</PageLayout>
