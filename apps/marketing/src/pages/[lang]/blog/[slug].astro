---
import { render } from 'astro:content';

import PageLayout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Media from '~/components/Media.astro';
import DevlogSeries from '~/components/blog/DevlogSeries.astro';
import { findImage } from '~/utils/images';

import { pagePath, OG_LOCALE, SITE_ORIGIN, type Language } from '~/utils/i18n';
import { publishedPosts, urlOf, alternatesOfPost } from '~/utils/posts';
import { blogCopy } from '~/copy/blog';

// One entry per PUBLISHED post. A draft produces no path, so it is absent from
// the output entirely rather than merely unlinked.
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { lang: post.data.language, slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const language = post.data.language as Language;
const t = blogCopy[language];

const { Content } = await render(post);
const alternates = await alternatesOfPost(post);

/**
 * The categories that are an ongoing SERIES rather than a standalone post. A
 * post in one of these gets the series rail linking every part; anything else
 * renders exactly as before. Declared per language, because the category string
 * a Hebrew post carries is itself Hebrew.
 */
const SERIES_CATEGORIES: Record<Language, readonly string[]> = {
  he: ['יומן בנייה'],
  en: ['Build log'],
};
const isSeriesPost = Boolean(post.data.category && SERIES_CATEGORIES[language].includes(post.data.category));

const metadata = {
  title: post.data.title,
  description: post.data.excerpt,
  canonical: urlOf(post),
  openGraph: {
    url: urlOf(post),
    locale: OG_LOCALE[language],
    type: 'article',
  },
};

/**
 * The post's cover, resolved to something a crawler can actually fetch.
 *
 * The frontmatter value is an authoring path (`~/assets/images/...`), which the
 * page's own <Image> resolves for rendering. Structured data gets no such
 * treatment: whatever string is put there is published verbatim, so passing the
 * authoring path through emits a reference to a file that exists nowhere,
 * silently, in a block no reader ever sees. It is resolved to the built asset and
 * made absolute, or omitted, because an absent image is a smaller lie than a
 * broken one.
 */
const cover = await findImage(post.data.image);
const coverSrc = typeof cover === 'string' ? cover : cover?.src;
const coverUrl = coverSrc
  ? (coverSrc.startsWith('http') ? coverSrc : `${SITE_ORIGIN}${coverSrc}`)
  : undefined;

/**
 * Structured data for the post.
 *
 * The landing pages already carry it and a blog post is the surface it was
 * designed for: it is what lets a result show a date and an author rather than a
 * bare title. Emitted as an inline `application/ld+json` block, which is data
 * rather than behaviour, so the page still ships no executable script.
 *
 * `inLanguage` is not decoration here. Half the posts are Hebrew and half are
 * English, they live under different prefixes, and a crawler that has to infer
 * the language from the text is one that can get it wrong on a short post.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  inLanguage: language === 'he' ? 'he-IL' : 'en',
  datePublished: post.data.publishDate.toISOString(),
  url: urlOf(post),
  mainEntityOfPage: { '@type': 'WebPage', '@id': urlOf(post) },
  publisher: { '@type': 'Organization', name: 'RushPoint', url: `${SITE_ORIGIN}/` },
  ...(coverUrl ? { image: coverUrl } : {}),
};

const dateFormat = new Intl.DateTimeFormat(language === 'he' ? 'he-IL' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PageLayout metadata={metadata} language={language} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

  <article class="px-4 py-8 sm:px-6 mx-auto max-w-3xl lg:px-8 lg:py-12">
    <header class="mb-8">
      <p class="text-sm text-muted dark:text-slate-400 mb-2">
        {t.publishedOn}{' '}
        <time datetime={post.data.publishDate.toISOString()}>{dateFormat.format(post.data.publishDate)}</time>
      </p>
      <h1 class="text-4xl font-bold tracking-tight leading-tight mb-4">{post.data.title}</h1>
      {post.data.excerpt && <p class="text-xl text-muted dark:text-slate-400">{post.data.excerpt}</p>}
    </header>

    {
      post.data.image && (
        <Image
          class="mb-8 rounded-lg w-full"
          src={post.data.image}
          alt={post.data.title}
          width={1024}
          height={576}
          loading="eager"
        />
      )
    }

    {
      post.data.media && (
        // Self-hosted, same as the standing pages: a file we serve, not a
        // third-party embed. Sits after the opening text — an addition to the
        // post, never a prerequisite for reading it.
        <Media class="mb-8" media={post.data.media} />
      )
    }

    {
      isSeriesPost && post.data.category && (
        <DevlogSeries language={language} currentSlug={post.data.slug} category={post.data.category} />
      )
    }

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <Content />
    </div>

    <footer class="mt-12 border-t border-gray-200 pt-6 dark:border-slate-700">
      <a class="inline-block py-1 font-medium text-secondary hover:underline" href={pagePath(language, 'blog')}>{t.backToBlog}</a>
    </footer>
  </article>
</PageLayout>
