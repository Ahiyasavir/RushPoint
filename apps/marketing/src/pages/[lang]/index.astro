---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import TryMission from '~/components/widgets/TryMission.astro';
import MissionIdeas from '~/components/widgets/MissionIdeas.astro';
import GamePlanner from '~/components/widgets/GamePlanner.astro';
import FAQs from '~/components/widgets/FAQs.astro';

import { LANGUAGES, alternatesFor, pageUrl, pagePath, OG_LOCALE, type Language } from '~/utils/i18n';
import { landingPageUrl } from '~/navigation';
import { pageContent } from '~/utils/pages';
import Media from '~/components/Media.astro';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const language = Astro.params.lang as Language;
const t = await pageContent('homePages', 'home', language);

const metadata = {
  title: t.title,
  description: t.description,
  canonical: pageUrl(language, ''),
  openGraph: { url: pageUrl(language, ''), locale: OG_LOCALE[language], type: 'website' },
};
---

<PageLayout metadata={metadata} language={language} alternates={alternatesFor('')}>
  <Hero
    tagline={t.tagline}
    actions={[
      { variant: 'primary', text: t.primaryAction, href: 'https://creator.rush-point.com', target: '_blank' },
      { text: t.secondaryAction, href: pagePath(language, 'story') },
    ]}
  >
    <Fragment slot="title" set:html={t.headline} />
    <Fragment slot="subtitle" set:html={t.subhead} />
  </Hero>

  {
    /*
      A picture or a video of a real game, straight after the headline. Optional:
      with none set the page is exactly what it was, so adding one is a content
      decision rather than a deploy.
    */
    t.hero && (
      <section class="px-4 sm:px-6 mx-auto max-w-5xl">
        <Media media={t.hero} eager />
      </section>
    )
  }

  <Features
    id="what-it-is"
    tagline={t.featuresTagline}
    title={t.featuresTitle}
    subtitle={t.featuresSubtitle}
    items={t.features}
  />

  <Steps title={t.stepsTitle} items={t.steps} isReversed />

  {
    /*
      A mission the visitor can actually play (change: try-a-mission). Everything above this
      point DESCRIBES the product; a field game is a thing you feel. Optional content, so a
      page without it renders exactly as it did before.
    */
    t.tryMission && <TryMission content={t.tryMission} />
  }

  {
    /*
      Having felt what playing is like, the visitor's next question is what they would have to
      WRITE. This answers it with ideas they can use as they are, signed up or not.
    */
    t.missionIdeas && <MissionIdeas content={t.missionIdeas} />
  }

  {
    /*
      And the question that decides whether the day works at all: how many stations. Same
      capacity model scripts/preflight-game.ts runs against a real game before an event.
    */
    t.gamePlanner && <GamePlanner content={t.gamePlanner} />
  }

  {
    /*
      Objections, answered plainly. Where there is a real limit (a free run caps at a hundred
      participants) the limit is stated rather than dodged: someone who finds it out on the day
      of their event is a worse outcome than someone who reads it here and plans around it.
    */
    t.faqs.length > 0 && <FAQs title={t.faqTitle} items={t.faqs} columns={2} />
  }

  {
    /*
      The gallery. This is the section that shows what a game actually looks
      like, which no amount of description does. It renders only when there is
      something in it: an empty gallery is not an empty section with a heading
      over it, it is absent.
    */
    t.gallery.length > 0 && (
      <section class="px-4 py-12 sm:px-6 mx-auto max-w-6xl lg:px-8">
        {t.galleryTitle && (
          <h2 class="mb-3 text-3xl font-bold tracking-tight text-center">{t.galleryTitle}</h2>
        )}
        {t.gallerySubtitle && (
          <p class="mb-10 text-lg text-muted dark:text-slate-400 text-center max-w-2xl mx-auto">
            {t.gallerySubtitle}
          </p>
        )}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {t.gallery.map((item) => (
            <Media media={item} />
          ))}
        </div>
      </section>
    )
  }

  <CallToAction
    actions={[
      { variant: 'primary', text: t.primaryAction, href: 'https://creator.rush-point.com', target: '_blank' },
      { text: t.ideasAction, href: landingPageUrl(language) },
    ]}
  >
    <Fragment slot="title" set:html={t.ctaTitle} />
    <Fragment slot="subtitle" set:html={t.ctaSubtitle} />
  </CallToAction>
</PageLayout>
