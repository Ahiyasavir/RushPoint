---
/**
 * RushPoint Live — the team application form (change: rushpoint-live-signup).
 *
 * HEBREW ONLY, and the route enforces it rather than the copy: `getStaticPaths`
 * emits the `he` path and nothing else, so `/en/live/` is a 404 rather than a page
 * of Hebrew served under an English URL. The event is one race across Jerusalem for
 * teams living in Israel — an English version would be advertising to people who
 * cannot attend, and a half-translated one is worse than none. See LIVE_EVENT_PATH
 * in utils/i18n.ts for why this is deliberately not a STANDING_SUBJECT.
 *
 * THREE QUESTIONS (change: rushpoint-live-short-form, 15.10). It used to be nine
 * answers and a group photo, and that was putting teams off applying; now it is the
 * team size, the ages and a phone number, and everything else is asked on the call.
 * The server still accepts the old fields, validated, so an open tab keeps working.
 *
 * A PAGE, NOT A DIALOG. A form somebody may still finish only after asking four
 * friends how old they are. That needs an address they can send to the team, which a modal does not
 * have; it also needs the browser's own back button to mean something.
 *
 * The copy is inline rather than in src/data/pages/*.json because those files are
 * checked in matching language PAIRS, and this page has no counterpart by design.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import TopoBackdrop from '~/components/TopoBackdrop.astro';
import { Icon } from 'astro-icon/components';
import EventCountdown from '~/components/EventCountdown.astro';
import QuestionCard from '~/components/live/QuestionCard.astro';

import {
  API_ORIGIN,
  CONTACT_FALLBACK_EMAIL,
  FACEBOOK_URL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  TIKTOK_HANDLE,
  TIKTOK_URL,
  LANGUAGES,
  OG_LOCALE,
  alternatesFor,
  pageUrl,
  type Language,
} from '~/utils/i18n';
import { liveCopy } from '~/copy/live';

export function getStaticPaths() {
  // BOTH languages now (change: rushpoint-live-english). It used to emit Hebrew
  // only, on the reasoning that an English page would advertise a Jerusalem race
  // to people who cannot attend. That was half right: it is a race for people IN
  // Israel, which is not the same as people who read Hebrew — a large part of the
  // country reads English first, and they were the ones being shut out.
  //
  // WHERE somebody is decides whether the home page BAND appears, not which
  // language they read (utils/israelAudience.ts). This page itself is always
  // reachable in both, because links get shared and refusing to render a page
  // somebody was deliberately sent is the worse failure by far.
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const language = Astro.params.lang as Language;
const t = liveCopy[language];

const metadata = {
  title: t.title,
  // This is what WhatsApp and Google show when the link is SHARED, which is how
  // most of these applications will actually arrive — so it carries the same
  // promise the page does, and names no prize the page does not name either.
  description: t.description,
  canonical: pageUrl(language, 'live'),
  openGraph: { url: pageUrl(language, 'live'), locale: OG_LOCALE[language], type: 'website' },
};

/**
 * Where we announce the ten teams.
 *
 * Declared as ONE list so adding a fourth network is one entry rather than three
 * edits in two files. `handle` is optional on purpose: the Facebook profile is a
 * numeric url with no vanity name, so it is labelled by the network instead of by
 * an @ that does not exist.
 */
const NETWORKS = [
  { href: INSTAGRAM_URL, handle: INSTAGRAM_HANDLE, label: t.followCta, icon: 'tabler:brand-instagram' },
  { href: TIKTOK_URL, handle: TIKTOK_HANDLE, label: t.followCtaTikTok, icon: 'tabler:brand-tiktok' },
  { href: FACEBOOK_URL, handle: null, label: t.followCtaFacebook, icon: 'tabler:brand-facebook' },
];

/** How many answers the progress bar counts: the three the short form asks for. */
const REQUIRED_COUNT = 3;

/** Each question by position, so the markup below reads them by name. */
const Q = t.questions;

/** Shared input styling. One string so the fields cannot drift from one another. */
const FIELD =
  'w-full rounded-xl border border-line bg-page px-4 py-3 text-base text-default ' +
  'placeholder:text-muted/70 transition focus:border-primary focus:outline-none ' +
  'focus-visible:ring-2 focus-visible:ring-primary/40 ' +
  'aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-red-500/25';
---

<PageLayout metadata={metadata} language={language} alternates={alternatesFor('live')}>
  {/* ── The pitch ───────────────────────────────────────────────────────── */}
  <section class="relative overflow-hidden bg-[#14110d] text-[#faf7f2]">
    <TopoBackdrop class="opacity-[0.07]" />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-40 start-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-primary/25 blur-3xl rtl:translate-x-1/2"
    >
    </div>

    <div class="relative mx-auto max-w-3xl px-4 py-14 text-center sm:px-6 sm:py-20">
      <p
        class="mx-auto flex w-fit items-center gap-2 rounded-full border border-primary/40 bg-primary/15 px-4 py-1.5 text-sm font-bold text-[#ffb59a]"
      >
        <Icon name="tabler:flame" class="h-4 w-4 shrink-0" aria-hidden="true" />
        <span>{t.badge}</span>
      </p>

      <h1 class="mt-5 font-heading text-4xl font-black leading-tight tracking-tight sm:text-6xl">
        {t.headlineTop}
        <span class="block text-primary">{t.headlineBottom}</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[#d8d0c5] sm:text-xl">
        {t.blurb}
      </p>

      {/* The deadline. Real, anchored, and printed beside the date it counts to. */}
      <EventCountdown class="mt-9" tone="dark" language={language} />

      {/*
        The way in, at the TOP (change: rushpoint-live-findability).

        Measured before this existed: on a 375x812 phone the first question sat
        1693px down — 2.1 full screens — behind the hero, the countdown, three
        stat tiles, the prize paragraph and the "what we are looking for" section.
        During the first real intake people could not find the questions. They had
        already decided to apply; they simply could not locate the form.

        Everything above the questions earns its place, because it is what
        convinces somebody to apply at all. So the fix is not to cut the pitch —
        it is to stop making a person who has ALREADY decided scroll through an
        argument they no longer need.

        A real anchor, not a scripted scroll, so it works with scripting off and a
        long press can still open it in a new tab. `scroll-margin-top` on the
        target does the rest; see the note there.
      */}
      <a
        class="mt-8 inline-flex min-h-14 w-full max-w-sm items-center justify-center gap-2 rounded-full bg-primary px-8 text-lg font-black text-white shadow-lg shadow-primary/25 transition hover:bg-secondary focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/50 sm:w-auto"
        href="#apply"
        data-hero-jump
      >
        <Icon name="tabler:arrow-down" class="h-6 w-6 shrink-0" aria-hidden="true" />
        <span>{t.jumpToForm}</span>
      </a>

      <ul class="mx-auto mt-9 grid max-w-xl grid-cols-3 gap-3 text-center">
        {
          t.facts.map((fact) => (
            <li class="rounded-2xl border border-white/10 bg-white/[0.04] px-2 py-4">
              <div class="font-heading text-2xl font-black sm:text-3xl">{fact.value}</div>
              <div class="mt-1 text-xs text-[#b6ada1] sm:text-sm">{fact.label}</div>
            </li>
          ))
        }
      </ul>

      {/*
        The prize, honestly.

        It is not fixed yet: it may be bigger, it may be smaller, and it may not be
        money at all. Naming a number we might not keep would be the one claim on
        this page a team could later catch us out on, and the scarcity above it is
        only worth something while everything beside it holds. So the reveal is the
        promise, and what is CERTAIN does the persuading instead.
      */}
      <p class="mx-auto mt-7 max-w-xl text-base leading-relaxed text-[#b6ada1]">{t.prize}</p>

      {/*
        Who is eligible, said in the hero rather than left to be inferred from a
        placeholder. Teams read the old example in the age field, "16 עד 18", as
        the permitted WINDOW and assumed anyone older was excluded — a sample
        answer in a form is read as a rule, especially when it is the only number
        on the subject anywhere on the page.
      */}
      <p class="mx-auto mt-4 flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-sm font-bold text-[#faf7f2]">
        <Icon name="tabler:users" class="h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
        <span>{t.eligibility}</span>
      </p>
    </div>
  </section>

  {/* ── What we are looking for ─────────────────────────────────────────── */}
  {/*
    The single highest-value section on the page, and it is not about the event
    at all. Casting teams for this genre say plainly that they choose for
    chemistry, energy and an interesting relationship — not for looks, fitness or
    experience in front of a camera. Teams disqualify THEMSELVES against an
    imagined standard long before anyone reads their answers, so saying out loud
    what is actually being judged converts better than another paragraph of
    adjectives about the race would.

    It sits directly ABOVE the form so a team reads what is being looked for
    before it applies.
  */}
  <section class="bg-surface-tint">
    <div class="mx-auto max-w-2xl px-4 py-12 sm:px-6 sm:py-14">
      <h2 class="font-heading text-2xl font-black tracking-tight text-heading sm:text-3xl">
        {t.lookingTitle}
      </h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <ul class="space-y-3 rounded-2xl border border-line bg-page p-5">
          {
            t.lookingYes.map((line) => (
              <li class="flex gap-2.5">
                <Icon name="tabler:check" class="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
                <span class="text-base leading-relaxed text-default">{line}</span>
              </li>
            ))
          }
        </ul>
        <ul class="space-y-3 rounded-2xl border border-line bg-page p-5">
          {
            t.lookingNo.map((line) => (
              <li class="flex gap-2.5">
                <Icon name="tabler:x" class="mt-0.5 h-5 w-5 shrink-0 text-muted" aria-hidden="true" />
                <span class="text-base leading-relaxed text-muted">{line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── The form ────────────────────────────────────────────────────────── */}
  {/*
    `scroll-mt-20` is not decoration. The progress bar below is `sticky top-0`, so
    a jump to this anchor would otherwise park the heading UNDERNEATH it and land
    the visitor looking at a bar with no heading above it.
  */}
  <section class="mx-auto max-w-2xl scroll-mt-20 px-4 py-12 sm:px-6 sm:py-16" id="apply">
    <h2 class="font-heading text-3xl font-black tracking-tight text-heading sm:text-4xl">
      {t.formTitle}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-muted">{t.formIntro}</p>
    {/*
      Said ONCE, here, instead of ten red asterisks down the page. Ten little
      warnings on a page whose job is to feel like an invitation is ten reasons to
      close the tab; red is now reserved for an actual problem, which is what makes
      it mean something when it finally appears.
    */}
    <p class="mt-3 text-sm font-semibold text-heading">{t.allRequired}</p>
    {/* Repeated here because the hero jump button skips the hero entirely. */}
    <p class="mt-1 text-sm font-semibold text-heading">{t.eligibility}</p>

    {/*
      The progress bar (change: rushpoint-live-urgency).

      Showing progress through a multi-answer form measurably raises completion,
      and starting it ABOVE zero raises it further — the endowed progress effect,
      from the study where a loyalty card handed over with two stamps already on
      it was finished at nearly twice the rate of a shorter empty one. Arriving
      and reading this far IS a real step, so the bar says so.

      It is sticky because its whole job is to be visible while scrolling past
      the questions; a progress bar you have scrolled away from is decoration.
      `top-0` rather than a guessed offset, and `backdrop-blur` so text passing
      underneath stays readable.
    */}
    <div class="sticky top-0 z-20 -mx-4 mt-8 border-b border-line bg-page/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6">
      <div class="flex items-center justify-between gap-3">
        <span class="text-sm font-semibold text-heading" data-progress-label>{t.progressStart}</span>
        <span class="text-sm font-bold tabular-nums text-primary" data-progress-count>{t.progressCount(0, REQUIRED_COUNT)}</span>
      </div>
      {/*
        A real progressbar role with real values, so this is a status to assistive
        technology rather than a decorative stripe. `transition-[width]` only —
        animating `all` here would also animate the colour on every keystroke.
      */}
      <div
        class="mt-2 h-2 w-full overflow-hidden rounded-full bg-surface-tint"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="8"
        aria-label={t.formTitle}
        data-progress-track
      >
        <div class="h-full rounded-full bg-primary transition-[width] duration-300 ease-out" style="width:8%" data-progress-fill></div>
      </div>
    </div>

    {/*
      A real <form> with real labels, and `novalidate` so the page — not the
      browser's own bubble — decides what a refusal says. The fields, the labels and
      the copy are all in the static markup, so the page still says what it is for
      with scripting disabled.
    */}
<form
      id="live-form"
      class="mt-8 flex flex-col gap-4"
      novalidate
      data-language={language}
      data-api-origin={API_ORIGIN}
    >
      {/* 01 — the event's own rule, so the control cannot express a number outside it. */}
      <QuestionCard n={Q[0].n} field="teamSize" title={Q[0].title} hint={Q[0].hint}>
        <select class={FIELD} id="f-teamSize" name="teamSize" required>
          <option value="">{t.choosePrompt}</option>
          <option value="5">5</option>
          <option value="6">6</option>
          <option value="7">7</option>
          <option value="8">8</option>
        </select>
      </QuestionCard>

      {/* 02 — free text on purpose: "16 עד 18" and "רובנו בני 30, אחד בן 52" are
          both real answers, and a range picker refuses the second one. */}
      <QuestionCard n={Q[1].n} field="ageRange" title={Q[1].title} hint={Q[1].hint}>
        <input class={FIELD} id="f-ageRange" name="ageRange" type="text" maxlength="120" placeholder={Q[1].placeholder} required />
      </QuestionCard>

      {/* 03 */}
      <QuestionCard n={Q[2].n} field="phone" title={Q[2].title} hint={Q[2].hint}>
        {/*
          `type="tel"` for the numeric keypad, `dir="ltr"` because a phone number
          reads left to right inside a right-to-left page, and `text-start` so it
          still sits against the edge the rest of the form does.
        */}
        <input
          class={`${FIELD} text-start`}
          id="f-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          dir="ltr"
          maxlength="40"
          autocomplete="tel"
          placeholder={Q[2].placeholder}
          required
        />
      </QuestionCard>

      {/*
        Following on Instagram (change: rushpoint-live-instagram).

        NOT A GATE, deliberately. A required checkbox here would be theatre: we
        cannot verify a follow, so all it would collect is a box that is true by
        construction for every single application — no information, and one more
        obstacle between a real team and the form.

        What actually makes people follow is a REASON that serves them plus the
        right moment. The reason is true and is stated plainly: the ten teams are
        announced there. The moment is after they submit, not before — the success
        screen carries the primary ask, when they are committed and waiting on an
        answer. This block is the earlier, softer half, placed where somebody who
        is already sold can act on it without leaving the form behind.

        Opens in a new tab on purpose: a half filled application must survive the
        detour. `noopener` because a `_blank` link without it hands the opened page
        a handle on this one.
      */}
      <div class="mt-2 rounded-2xl border-2 border-line bg-surface-tint p-5 sm:p-6">
        <div class="flex items-start gap-3.5">
          <Icon name="tabler:brand-instagram" class="mt-0.5 h-9 w-9 shrink-0 text-primary" aria-hidden="true" />
          <div class="min-w-0 flex-1">
            <h3 class="font-heading text-xl font-black leading-snug text-heading">{t.followTitle}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{t.followBody}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                NETWORKS.map((net) => (
                  <a
                    class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full border-2 border-primary bg-page px-4 text-base font-black text-primary transition hover:bg-primary hover:text-white focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/40"
                    href={net.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-follow-link
                  >
                    <Icon name={net.icon} class="h-5 w-5 shrink-0" aria-hidden="true" />
                    {/* The handle where there is one: it differs between the
                        networks, and a reader who searches by hand needs the right
                        one. Where there is none, the network's own name. */}
                    <span>{net.handle ? `@${net.handle}` : net.label}</span>
                  </a>
                ))
              }
            </div>
            {/* Acknowledged once they have actually gone. It is not proof — nothing
                here could be — it is the page noticing, which is what makes the ask
                feel like an exchange rather than an instruction. */}
            <p class="mt-2 hidden text-sm font-semibold text-primary" data-follow-done>{t.followDone}</p>
          </div>
        </div>
      </div>

      {/*
        The close. A form that ends at a button ends on an administrative note;
        this ends on the thing they are actually reaching for, immediately above
        the press. It is not a new claim — everything in it is already true
        elsewhere on the page — it is the reason restated at the moment of decision.
      */}
      <div class="mt-4 rounded-2xl border-2 border-primary/30 bg-primary/[0.06] p-5 text-center sm:p-6">
        <p class="font-heading text-xl font-black leading-snug text-heading sm:text-2xl">
          {t.closeTitle}
        </p>
        <p class="mx-auto mt-2 max-w-md text-base leading-relaxed text-muted">{t.closeBody}</p>

        <button
          class="mt-5 inline-flex min-h-14 w-full items-center justify-center gap-2 rounded-full bg-primary px-8 text-lg font-black text-white shadow-lg shadow-primary/25 transition hover:bg-secondary focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/50 disabled:opacity-70"
          id="live-submit"
          type="submit"
          data-label={t.submit}
          data-sending={t.sending}
        >
          {t.submit}
        </button>

        {/* One status region for every outcome, announced to assistive technology.
            It starts EMPTY rather than hidden, so the live region already exists
            when the first message lands in it. */}
        <p class="mt-3 min-h-6 text-base font-medium" id="live-status" role="status" aria-live="polite"></p>
      </div>

      <p class="text-sm leading-relaxed text-muted">
        {t.privacy} {t.contactLead}{' '}
        <a class="text-secondary underline hover:text-primary" dir="ltr" href={`mailto:${CONTACT_FALLBACK_EMAIL}`}>
          {CONTACT_FALLBACK_EMAIL}
        </a>
      </p>
    </form>
  </section>
</PageLayout>

<script>
  // Page local. No framework, no hydration: the page is readable and says what it
  // is for without this, and this only exists to check the answers and send them.
  //
  // A BUNDLED script, not an inline one. It used to carry its two server values
  // through `define:vars`, which forces `is:inline` and therefore forbids imports
  // — and the progress arithmetic would then have had to be copied here, where it
  // could silently drift from the version the gate actually tests. The two values
  // ride on the form's own data attributes instead.
  import { applicationProgress } from '~/utils/liveEvent';
  import { liveCopy } from '~/copy/live';
  import { FACEBOOK_URL, INSTAGRAM_URL, TIKTOK_URL } from '~/utils/i18n';

  // Typed once, here. The non-null assertions are honest: every one of these ids
  // is in the markup directly above, so a missing element is a mistake made at
  // build time, not a case the page has to survive at runtime.
  const form = document.getElementById('live-form') as HTMLFormElement;
  const language = form.dataset.language ?? '';
  const apiOrigin = form.dataset.apiOrigin ?? '';

  // Every word this script can put on screen comes from the copy module, which
  // scripts/test-marketing-content.ts checks for language purity. A literal
  // typed here would be checked by nothing — and a Hebrew sentence surfacing in
  // the English page is precisely the failure that gate exists to catch.
  // The fallback is Hebrew because a broken `lang` means the Hebrew route.
  const t = liveCopy[language === 'en' ? 'en' : 'he'];
  const status = document.getElementById('live-status') as HTMLParagraphElement;
  const submit = document.getElementById('live-submit') as HTMLButtonElement;

  // ── Messages ───────────────────────────────────────────────────────────────
  // Every refusal names the field and says what to do about it.

  const FIELD_ERRORS: Record<string, string> = t.fieldErrors;

  // ── Field state ────────────────────────────────────────────────────────────

  function errorSlot(field: string): HTMLElement | null {
    return form.querySelector(`[data-error-for="${field}"]`);
  }

  /** Every control that carries this field's answer — one input, or a whole group. */
  function controlsFor(field: string): HTMLElement[] {
    return [...form.querySelectorAll<HTMLElement>(`[name="${field}"]`)];
  }

  function clearError(field: string): void {
    const slot = errorSlot(field);
    if (slot) {
      slot.textContent = '';
      slot.classList.add('hidden');
    }
    for (const control of controlsFor(field)) control.removeAttribute('aria-invalid');
  }

  function markError(field: string, message?: string): HTMLElement | null {
    const slot = errorSlot(field);
    if (slot) {
      slot.textContent = message ?? FIELD_ERRORS[field] ?? t.errInvalid;
      slot.classList.remove('hidden');
    }
    // A checkbox/radio group gets the flag on its first control, which is what a
    // screen reader lands on when it reaches the group.
    const controls = controlsFor(field);
    if (controls[0]) controls[0].setAttribute('aria-invalid', 'true');
    return controls[0] ?? null;
  }

  function clearAllErrors() {
    for (const field of Object.keys(FIELD_ERRORS)) clearError(field);
  }

  // Clearing as they fix it. Waiting for the next submit to withdraw a complaint
  // the person has already answered makes the form look broken.
  form.addEventListener('input', (event) => {
    const field = (event.target as HTMLInputElement | null)?.name;
    if (field && FIELD_ERRORS[field]) clearError(field);
    refreshProgress();
    saveDraft();
  });
  form.addEventListener('change', (event) => {
    const field = (event.target as HTMLInputElement | null)?.name;
    if (field && FIELD_ERRORS[field]) clearError(field);
    refreshProgress();
    saveDraft();
  });

  // ── Progress ───────────────────────────────────────────────────────────────
  //
  // Answered COUNT, not fields touched: a field typed into and then emptied has
  // gone backwards, and a bar that only ever rises would be lying about that.
  // The arithmetic itself is imported rather than written here, so the number on
  // screen is the one scripts/test-live-event-countdown.ts actually checks.

  // The answers that are required, and therefore the ones the bar counts.
  const PROGRESS_FIELDS = Object.keys(FIELD_ERRORS);

  // Queried from the DOCUMENT, not from the form. The bar is a sibling of the
  // <form>, not a child of it — it is sticky and has to sit outside the element
  // it reports on — so `form.querySelector` returns null for all four, and every
  // guarded update below silently becomes a no-op. That is a progress bar that
  // ships looking perfect and never moves, which is how this was first written.
  const progressFill = document.querySelector<HTMLElement>('[data-progress-fill]');
  const progressTrack = document.querySelector<HTMLElement>('[data-progress-track]');
  const progressCount = document.querySelector<HTMLElement>('[data-progress-count]');
  const progressLabel = document.querySelector<HTMLElement>('[data-progress-label]');

  /** Said at the top of the bar. Warmth, and a reason to keep going. */
  function progressWord(done: number, total: number): string {
    if (done === 0) return t.progressStart;
    if (done === total) return t.progressDone;
    if (done >= total - 2) return t.progressNearly;
    if (done >= total / 2) return t.progressHalf;
    return t.progressGoing;
  }

  /** Is this one question answered? The single definition of "answered". */
  function isAnswered(field: string, data: FormData): boolean {
    return String(data.get(field) ?? '').trim() !== '';
  }

  function refreshProgress(): void {
    const total = PROGRESS_FIELDS.length;
    const data = new FormData(form);

    // Each card's badge flips to a check the moment its question is answered, so
    // the page acknowledges every answer instead of silently accepting it. Driven
    // from the SAME predicate as the count below, so a card and the bar can never
    // disagree about whether something was answered.
    let done = 0;
    for (const field of PROGRESS_FIELDS) {
      const answered = isAnswered(field, data);
      if (answered) done += 1;
      const card = document.querySelector(`[data-question="${field}"]`);
      if (card) card.setAttribute('data-answered', String(answered));
    }

    const percent = applicationProgress(done, total);

    if (progressFill) progressFill.style.width = `${percent}%`;
    if (progressTrack) progressTrack.setAttribute('aria-valuenow', String(percent));
    if (progressCount) progressCount.textContent = t.progressCount(done, total);
    if (progressLabel) progressLabel.textContent = progressWord(done, total);
  }

  // ── The draft ──────────────────────────────────────────────────────────────
  //
  // A team may stop to ask four friends how old they are, so closing the tab must
  // not cost them what they already wrote. Restored on load, cleared once sent.
  //
  // Every read and write is wrapped: this storage throws outright in some private
  // modes and returns empty in others, and a saved draft is a convenience — the
  // form must work identically for somebody whose browser has it turned off.

  const DRAFT_KEY = 'rp-live-draft';

  function saveDraft(): void {
    try {
      const data = new FormData(form);
      const draft: Record<string, string> = {};
      for (const field of PROGRESS_FIELDS) draft[field] = String(data.get(field) ?? '');
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    } catch { /* storage blocked or full — the draft is a convenience, not the form */ }
  }

  function clearDraft(): void {
    try { localStorage.removeItem(DRAFT_KEY); } catch { /* nothing was stored either */ }
  }

  function restoreDraft(): boolean {
    // No initializer: both branches below assign it, so a starting value here is
    // dead code (and eslint's no-useless-assignment says so).
    let draft;
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      draft = raw ? JSON.parse(raw) : null;
    } catch { draft = null; }
    // Anything but an object is not a draft. Stored data can be edited by hand,
    // can be left over from an older shape of this form, or can be truncated.
    if (!draft || typeof draft !== 'object') return false;

    let restored = 0;
    for (const field of PROGRESS_FIELDS) {
      // A draft saved by the nine question form carries other fields too; only these are read.
      const value = draft[field];
      if (typeof value !== 'string' || value === '') continue;
      const control = form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${field}"]`);
      if (control) { control.value = value; restored += 1; }
    }
    return restored > 0;
  }

  const hadDraft = restoreDraft();
  refreshProgress();
  if (hadDraft) {
    // Said plainly, and only when something really came back. Silently refilling
    // a form is unsettling; claiming to have refilled an empty one is worse.
    show(t.draftRestored, true);
  }

  // ── Validation ─────────────────────────────────────────────────────────────

  /**
   * The same rule the server applies, so a number that will be refused is refused
   * here — where the person can still see the field. The server remains the
   * authority; this exists so they are told while the field is still in view.
   */
  function phoneIsDialable(raw: string): boolean {
    const digits = String(raw).replace(/[^0-9]/g, '');
    return /^05\d{8}$/.test(digits) || /^9725\d{8}$/.test(digits) || /^009725\d{8}$/.test(digits);
  }

  /** Every missing answer, in the order they appear on the page. */
  function missingFields(data: FormData): string[] {
    const missing: string[] = [];
    const text = (field: string) => String(data.get(field) ?? '').trim();

    if (!text('teamSize')) missing.push('teamSize');
    if (!text('ageRange')) missing.push('ageRange');
    if (!text('phone') || !phoneIsDialable(text('phone'))) missing.push('phone');

    return missing;
  }

  // ── Status ─────────────────────────────────────────────────────────────────

  function show(text: string, ok: boolean): void {
    status.textContent = text;
    status.className = ok
      ? 'min-h-6 text-base font-medium text-green-700 dark:text-green-400'
      : 'min-h-6 text-base font-medium text-red-700 dark:text-red-400';
  }

  // ── Submit ─────────────────────────────────────────────────────────────────

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearAllErrors();
    status.textContent = '';

    const data = new FormData(form);
    const missing = missingFields(data);

    if (missing.length > 0) {
      // Mark every one of them, then move to the FIRST — so the person sees the
      // full extent of what is left and lands on the one to do next.
      let firstControl = null;
      for (const field of missing) {
        const control = markError(field);
        if (!firstControl) firstControl = control;
      }
      show(missing.length === 1 ? t.missingOne : t.missingMany(missing.length), false);
      firstControl?.focus?.({ preventScroll: true });
      firstControl?.scrollIntoView?.({ behavior: 'smooth', block: 'center' });
      return;
    }

    submit.disabled = true;
    submit.textContent = submit.dataset.sending ?? '';

    try {
      const response = await fetch(`${apiOrigin}/submitLiveApplication`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          data: {
            teamSize: Number(data.get('teamSize')),
            ageRange: String(data.get('ageRange') ?? '').trim(),
            phone: String(data.get('phone') ?? '').trim(),
            language,
          },
        }),
      });

      if (response.ok) {
        // Only now, once the server has it. Clearing the draft on SEND would throw
        // away everything they wrote the moment a request failed.
        clearDraft();
        // Replace the form with the confirmation rather than clearing it. A blank
        // form under a success line is indistinguishable from one that failed and
        // wiped what they wrote.
        // The confirmation, and the one moment where asking for a follow costs
        // nothing and converts: they have just committed, they are waiting on an
        // answer, and this is genuinely where that answer gets published. The ask
        // is a consequence of what they already want, not a toll on the way in.
        //
        // Built with createElement rather than innerHTML because the copy is
        // interpolated: assigning a string here would make every sentence in the
        // copy module a potential injection point the day one of them carries an
        // angle bracket.
        form.replaceChildren();
        const done = document.createElement('div');
        done.className = 'rounded-2xl border-2 border-primary/30 bg-primary/[0.06] p-8 text-center';

        const h = document.createElement('p');
        h.className = 'font-heading text-2xl font-black text-heading';
        h.textContent = t.successTitle;

        const body = document.createElement('p');
        body.className = 'mt-3 text-lg leading-relaxed text-muted';
        body.textContent = t.successBody;

        const followH = document.createElement('p');
        followH.className = 'mt-8 font-heading text-xl font-black text-heading';
        followH.textContent = t.successFollowTitle;

        const followBody = document.createElement('p');
        followBody.className = 'mx-auto mt-2 max-w-md text-base leading-relaxed text-muted';
        followBody.textContent = t.successFollowBody;

        const row = document.createElement('div');
        row.className = 'mt-5 flex flex-wrap justify-center gap-2';
        for (const net of [
          { href: INSTAGRAM_URL, label: t.followCta },
          { href: TIKTOK_URL, label: t.followCtaTikTok },
          { href: FACEBOOK_URL, label: t.followCtaFacebook },
        ]) {
          const a = document.createElement('a');
          a.className =
            'inline-flex min-h-14 flex-1 items-center justify-center gap-2 rounded-full ' +
            'bg-primary px-5 text-base font-black text-white shadow-lg shadow-primary/25 ' +
            'transition hover:bg-secondary focus:outline-none focus-visible:ring-4 focus-visible:ring-primary/50';
          a.href = net.href;
          a.target = '_blank';
          // `noopener` is not optional on a target=_blank link: without it the page
          // we open can reach back through window.opener and navigate this tab.
          a.rel = 'noopener noreferrer';
          a.textContent = net.label;
          row.append(a);
        }

        done.append(h, body, followH, followBody, row);
        form.append(done);
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      // The callable transport reports its reason in the body, and this server
      // puts the FIELD NAME at the front of an invalid-argument message. Carrying
      // that through is the difference between a form that can be completed and
      // one that says only "something was wrong".
      let code = '';
      let message = '';
      try {
        const body = await response.json();
        code = body?.error?.status ?? '';
        message = String(body?.error?.message ?? '');
      } catch {
        code = '';
      }

      if (code === 'INVALID_ARGUMENT') {
        const field = message.split(':')[0]?.trim();
        if (FIELD_ERRORS[field]) {
          const control = markError(field);
          show(t.oneStillWrong, false);
          control?.focus?.({ preventScroll: true });
          control?.scrollIntoView?.({ behavior: 'smooth', block: 'center' });
        } else {
          show(t.errInvalid, false);
        }
      } else if (code === 'RESOURCE_EXHAUSTED') {
        show(t.errRateLimited, false);
      } else {
        show(t.errUnknown, false);
      }
    } catch {
      // fetch throws on a network failure, which is the one case where the server
      // never saw the application at all.
      show(t.errOffline, false);
    } finally {
      submit.disabled = false;
      submit.textContent = submit.dataset.label ?? '';
    }
  });

  // ── The Instagram ask ──────────────────────────────────────────────────────
  //
  // Nothing here verifies a follow, and nothing pretends to. Tapping through is
  // the only signal available, it is remembered so the acknowledgement survives a
  // reload of a half filled form, and it gates NOTHING: the application submits
  // exactly the same whether they went or not.
  const FOLLOW_KEY = 'rp-live-followed';
  const followLink = document.querySelector('[data-follow-link]');
  const followDone = document.querySelector('[data-follow-done]');

  function markFollowed(): void {
    followDone?.classList.remove('hidden');
  }

  try {
    if (localStorage.getItem(FOLLOW_KEY) === '1') markFollowed();
  } catch { /* storage blocked — the acknowledgement is a nicety, not the ask */ }

  followLink?.addEventListener('click', () => {
    try { localStorage.setItem(FOLLOW_KEY, '1'); } catch { /* nothing to remember, no matter */ }
    markFollowed();
  });
</script>
