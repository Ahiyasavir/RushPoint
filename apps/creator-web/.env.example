# ═══════════════════════════════════════════════════════════
# RushPoint Creator console (creator-web) — build-time env.
# Copy to apps/creator-web/.env (gitignored). VITE_* values are embedded in the
# built bundle — PUBLIC by design; never put secrets here.
# In local dev these are optional (emulator-safe defaults are baked in).
# ═══════════════════════════════════════════════════════════

# ── Firebase Web config — Console → Project settings → Your apps (Web) ───────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=rushpoint-pwa-7daaa
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Map provider (optional) ──────────────────────────────────────────────────
# MapTiler "outdoor" style — free tier, no card: https://cloud.maptiler.com
# Without it, maps fall back to keyless OpenTopoMap tiles.
VITE_MAPTILER_KEY=

# ── Crash reporting (optional) ────────────────────────────────────────────────
# Set a Sentry DSN to light up src/services/telemetry.ts.
# VITE_SENTRY_DSN=
