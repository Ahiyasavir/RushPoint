# ═══════════════════════════════════════════════════════════
# RushPoint Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ── Firebase (from Firebase Console → Project Settings → Your Apps) ──────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── RushPoint App Identity ────────────────────────────────────────────────────
# This is the Firestore root segment: artifacts/{RUSHPOINT_APP_ID}/...
# Use a short, URL-safe slug, e.g. "race-to-tzion-2026"
# Must match across mobile, admin, and functions.
EXPO_PUBLIC_RUSHPOINT_APP_ID=race-to-tzion-2026

# ── Map Provider ──────────────────────────────────────────────────────────────
# MapTiler — topographic "outdoor" style. Free tier 100k tiles/month, NO credit
# card. Create a key at https://cloud.maptiler.com (Account → Keys). Without it the
# mission map shows a friendly placeholder.
EXPO_PUBLIC_MAPTILER_KEY=

# Legacy (no longer used — maps moved to MapTiler/MapLibre):
# EXPO_PUBLIC_MAPBOX_TOKEN=

# ── Crash reporting (optional) ────────────────────────────────────────────────
# Set a Sentry DSN to light up the telemetry seam (src/services/telemetry.ts).
# You still register the transport once at startup: setCrashReporter(Sentry.captureException).
# EXPO_PUBLIC_SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to skip Firebase and use local mock data (useful in dev)
EXPO_PUBLIC_USE_MOCK_DATA=true

# ── Notes ─────────────────────────────────────────────────────────────────────
# All EXPO_PUBLIC_* vars are bundled into the app binary — never put secrets here.
# Server-side secrets (service account, admin keys) belong in functions/.env only.
