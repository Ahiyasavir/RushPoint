# ═══════════════════════════════════════════════════════════
# RushPoint Admin Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ── Firebase (same project as mobile) ────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── RushPoint App Identity ────────────────────────────────────────────────────
# Must match EXPO_PUBLIC_RUSHPOINT_APP_ID in the mobile app
VITE_RUSHPOINT_APP_ID=race-to-tzion-2026

# ── Map Provider ──────────────────────────────────────────────────────────────
# MapTiler — topographic "outdoor" style (hillshade + contours). Free tier 100k
# tiles/month, NO credit card: https://cloud.maptiler.com. Optional — without it
# the live map falls back to keyless OpenTopoMap tiles (still topographic).
VITE_MAPTILER_KEY=

# Legacy (no longer used):
# VITE_MAPBOX_TOKEN=

# ── Admin Auth ────────────────────────────────────────────────────────────────
# The admin panel signs in with email/password (Firebase Auth).
# The Firebase Auth custom claim { role: "admin" } must be set on the admin
# user's account BEFORE they can access write operations.
#
# To grant admin access, run in Firebase Admin SDK / Cloud Shell:
#   admin.auth().setCustomUserClaims(uid, { role: 'admin' })
#
# No secret key needed in this file — Firestore rules check the JWT claim.

# ── Crash reporting (optional) ────────────────────────────────────────────────
# Set a Sentry DSN to light up the telemetry seam (src/services/telemetry.ts).
# You still register the transport once at startup: setCrashReporter(Sentry.captureException).
# VITE_SENTRY_DSN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_USE_MOCK_DATA=false

# ── Notes ─────────────────────────────────────────────────────────────────────
# VITE_* vars are embedded in the built bundle — never put secrets here.
# The admin dashboard is deployed to Firebase Hosting (see firebase.json).
# Restrict its URL to internal access only in production.
