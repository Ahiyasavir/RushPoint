rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// RushPoint Platform v2 — Firestore Security Rules (Multi-Tenant)
//
// MODEL:
//   users/{uid}                                         creator profile + wallet ref
//   users/{uid}/games/{gameId}                          private game template (owner only)
//   users/{uid}/games/{gameId}/runs/{runId}             live run (owner only; CF-written)
//   …/runs/{runId}/teams/{teamId}                       a participating team/individual
//   …/runs/{runId}/{announcements|flashMissions|feedItems}  live-ops (read: run participant/staff/owner)
//   publicGames/{gameId}, publicTasks/{taskId}          denormalized gallery (read: any)
//   wallets/{uid}, wallets/{uid}/transactions/{txId}    credit ledger (owner read only)
//   accessCodes/{code}                                  join codes (any auth read)
//   auditLogs/{id}                                      immutable trail (CF only)
//
// All score/run/team mutations go through Cloud Functions (Admin SDK bypasses
// these rules). Client writes are intentionally narrow.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny everything not explicitly matched ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── CREATOR PROFILE ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);

      // ── GAME TEMPLATES ─────────────────────────────────────────────────────
      //    Owner-only for both read and write. The builder edits via the
      //    createGame/updateGame callables (Admin SDK) but direct owner writes
      //    are also permitted for responsiveness. publicGames is the read path
      //    for everyone else.
      //    TOMBSTONE (change: recoverable-game-deletion): deleting a game is now a
      //    server-written `deletedAt`/`deletedBy` pair with a 30-day grace period.
      //    Those two fields are SERVER-ONLY — a client must not be able to forge a
      //    tombstone (hiding a game from itself with no audit record) or clear one
      //    (undeleting past the grace period, or un-queueing a pending purge).
      //    Direct owner writes to the rest of the doc stay allowed as before; no
      //    client code writes a game document today, so this narrows nothing in use.
      match /games/{gameId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && !hasTombstone(request.resource.data);
        allow update: if isOwner(uid) && tombstoneUnchanged();
        allow delete: if isOwner(uid);

        // ── RUNS ─────────────────────────────────────────────────────────────
        //    Live instances. Owner reads everything; all writes are CF-only
        //    (score/leaderboard integrity).
        match /runs/{runId} {
          allow read:  if isOwner(uid);
          allow write: if false;

          // ── TEAMS ──────────────────────────────────────────────────────────
          //    A participant reads ONLY their own team doc for live sync: the
          //    founding uid (uid == teamId) or any phone attached to the team
          //    (shared-team-devices: uid listed in deviceUids). The owner reads
          //    all teams. Writes are CF-only.
          match /teams/{teamId} {
            allow read:  if isOwner(uid) || isOwner(teamId)
                          || isAttachedDevice()
                          || isStaffForRun(uid, gameId, runId);
            allow write: if false;
          }

          // ── LIVE-OPS BROADCASTS ────────────────────────────────────────────
          //    Announcements + flash missions are readable ONLY by the owner,
          //    run-scoped staff, or a participant of THIS run (not any authed
          //    user) — scoped to the run they belong to, matching their stated
          //    intent. Written by Staff via Cloud Functions.
          //    Targeted announcements (change: targeted-announcements): a doc may
          //    carry a `teamId` addressing one team, but rules CANNOT filter
          //    documents within a collection read — per-team visibility is enforced
          //    CLIENT-SIDE only (announcementVisibleTo). The `teamId` field is NOT
          //    secret: an announcement is operational copy, never an answer key.
          match /announcements/{docId} {
            allow read:  if isOwner(uid)
                          || isStaffForRun(uid, gameId, runId)
                          || isRunParticipant(uid, gameId, runId);
            allow write: if false;
          }
          match /flashMissions/{docId} {
            allow read:  if isOwner(uid)
                          || isStaffForRun(uid, gameId, runId)
                          || isRunParticipant(uid, gameId, runId);
            allow write: if false;
          }
          // Live photo feed (live-photo-feed): approved photos broadcast to the
          // run. Carries participant photo URLs + team names (PII), so reads are
          // scoped to the run's owner / run-scoped staff / a participant of THIS
          // run — NOT any authenticated user (fix-i18n-leaks-and-feed-authz).
          // Rules cannot conditionally gate reads on Game.photoFeedEnabled — the
          // flag is enforced WRITE-side (no items are ever written while the feed
          // is off); hideFeedItem is the moderation recourse for written items.
          match /feedItems/{docId} {
            allow read:  if isOwner(uid)
                          || isStaffForRun(uid, gameId, runId)
                          || isRunParticipant(uid, gameId, runId);
            allow write: if false;
          }

          // ── TEAM ↔ HQ CHAT (team-hq-chat) ──────────────────────────────────
          //    One thread doc per team. Same read surface as the team doc itself:
          //    founder (uid == teamId), attached devices, run-scoped staff, owner.
          //    deviceUids is mirrored onto this doc by sendTeamChatMessage so
          //    isAttachedDevice() works without a rules get(). All writes CF-only.
          //    List semantics: staff/owner clauses hold for every doc (HQ consoles
          //    listen to the whole collection); a participant's clauses depend on
          //    doc id / resource.data, so they can only get/listen to their own doc.
          match /chat/{teamId} {
            allow read:  if isOwner(uid) || isOwner(teamId)
                          || isAttachedDevice()
                          || isStaffForRun(uid, gameId, runId);
            allow write: if false;
          }

          // ── OPERATIONAL (alerts, locations, staffInvites) ──────────────────
          //    Owner reads; all writes + staff/participant reads go through CFs.
          match /alerts/{docId} {
            allow read:  if isOwner(uid) || isStaffForRun(uid, gameId, runId);
            allow write: if false;
          }
          match /teamLocations/{docId} {
            allow read:  if isOwner(uid);
            allow write: if false;
          }
          // Retained GPS track for the post-run movement heatmap (movement-heatmap).
          // Owner-read only; appended solely by updateLocation (Admin SDK).
          match /locationTrack/{docId} {
            allow read:  if isOwner(uid);
            allow write: if false;
          }
          // Trackable collectibles (trackable-collectibles): coordinates/holder aren't
          // secret (they render live), so any authed run participant may read; all
          // writes go through the pickup/drop/create callables (Admin SDK).
          match /trackables/{trackableId} {
            allow read:  if isAuthenticated();
            allow write: if false;
            match /log/{entryId} {
              allow read:  if isAuthenticated();
              allow write: if false;
            }
          }
          // Capturable territory zones (territory-capture): ownership renders live on
          // the map, so any authed run participant may read; captures go through the
          // captureZone callable (Admin SDK).
          match /zones/{zoneId} {
            allow read:  if isAuthenticated();
            allow write: if false;
          }

          // ── POST-GAME FEEDBACK (post-game-feedback) ────────────────────────
          //    One survey response per player, written only by submitRunFeedback
          //    (Admin SDK). Free text → owner-read-only; clients never write.
          match /feedback/{docId} {
            allow read:  if isOwner(uid);
            allow write: if false;
          }
          match /staffInvites/{docId} {
            allow read:  if isOwner(uid);
            allow write: if false;
          }
        }

        // ── DISCOVERY POIs (surprise-trivia-waypoints) ───────────────────────
        //    Hidden geofenced trivia waypoints. Coordinates + answers are
        //    SERVER-SECRET, so only the game owner may read/write these docs
        //    directly; play clients are denied and must go through the
        //    getRunDiscoveryPois / claimDiscoveryPoi callables.
        match /discoveryPois/{poiId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // ── PUBLIC GALLERY (denormalized, read-only to clients) ──────────────────
    match /publicGames/{gameId} {
      allow read:  if true;
      allow write: if false;
    }
    match /publicTasks/{taskId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── PUBLIC-CONTENT LIKES (change: gallery-popularity-ranking) ────────────
    //    publicLikes/{kind}_{itemId}_{uid} — one like per user per item, the id
    //    IS the uniqueness constraint. Server-write-only like every other signal
    //    that feeds a ranking: if a client could write here it could forge likes
    //    and pin its own game to the top of the gallery.
    //    Reads are denied too, deliberately — the caller's own like state comes
    //    back from searchGallery/searchTaskLibrary, so no client ever needs to
    //    query this collection, and denying it keeps the "who liked what" graph
    //    from being scrapable.
    match /publicLikes/{likeId} {
      allow read:  if false;
      allow write: if false;
    }

    // ── PLATFORM BENCHMARK (anonymized aggregate; no per-run ids) ─────────────
    //    Any authenticated creator may read the cross-platform median; only
    //    Cloud Functions contribute (rolling merge in finalizeRun).
    match /benchmarks/{taskType} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── WALLETS ──────────────────────────────────────────────────────────────
    match /wallets/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
      match /transactions/{txId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }
    }

    // ── PLAYER PROFILES ──────────────────────────────────────────────────────
    //    Cross-run lifetime stats + badges (player-profile-badges). A player reads
    //    only their OWN profile; it is written solely by CFs (recordPlayerResult).
    match /players/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // ── ACCESS CODES ─────────────────────────────────────────────────────────
    //    Any authenticated user may read to validate a code before joining.
    //    The pointer doc ({ownerUid, gameId, runId}) carries no secrets.
    match /accessCodes/{code} {
      // A get by a known code is how you join. Listing the whole collection would
      // enumerate every run's {ownerUid,gameId,runId} — deny it (anti-cheat row 39).
      allow get:   if isAuthenticated();
      allow list:  if false;
      allow write: if false;
    }

    // ── AUDIT LOGS ───────────────────────────────────────────────────────────
    //    Read only via the listAuditLogs callable (Admin SDK). Closed to clients.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // ── RATE-LIMIT COUNTERS ──────────────────────────────────────────────────
    //    Per-uid callable rate-limit windows (callable-rate-limiting, #19).
    //    Server-write-only — clients can neither read nor write them.
    match /rateLimits/{key} {
      allow read, write: if false;
    }


    // ═════════════════════════════════════════════════════════════════════════
    // Helpers
    // ═════════════════════════════════════════════════════════════════════════
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Game trash tombstone (change: recoverable-game-deletion). The tombstone is
    // written ONLY by the deleteGame / restoreGame callables (Admin SDK, which
    // bypasses these rules), so any client write that introduces, changes or
    // removes it is a forgery attempt and is denied.
    function hasTombstone(d) {
      return d.keys().hasAny(['deletedAt', 'deletedBy']);
    }
    function tombstoneUnchanged() {
      return hasTombstone(request.resource.data) == hasTombstone(resource.data)
          && (!hasTombstone(resource.data)
              || request.resource.data.deletedAt == resource.data.deletedAt);
    }
    // Shared team devices: an attached phone (its uid listed in the team doc's
    // deviceUids) may read that team doc. Checked against resource.data — free,
    // no extra document reads. Legacy docs (no deviceUids) fall back to the
    // isOwner(teamId) clause above.
    function isAttachedDevice() {
      return request.auth != null
          && 'deviceUids' in resource.data
          && request.auth.uid in resource.data.deviceUids;
    }
    // Staff signed in via the staffSignIn custom token. The token carries the
    // run scope it was minted for, so staff read is confined to that one run.
    function isStaffForRun(uid, gameId, runId) {
      return request.auth != null
          && request.auth.token.staff == true
          && request.auth.token.ownerUid == uid
          && request.auth.token.gameId == gameId
          && request.auth.token.runId == runId;
    }
    // A participant of THIS run: the caller owns a team doc under the run. Team
    // docs are keyed by the founding uid (uid == teamId), so run membership for
    // the founding device is exactly the existence of its team doc. Costs one
    // document read per subscription. (Secondary attached devices — deviceUids —
    // are NOT matched here; they read via the team/chat docs, not the raw feed.)
    function isRunParticipant(uid, gameId, runId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/users/$(uid)/games/$(gameId)/runs/$(runId)/teams/$(request.auth.uid));
    }
  }
}
