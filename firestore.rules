rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// RushPoint Platform v2 — Firestore Security Rules (Multi-Tenant)
//
// MODEL:
//   users/{uid}                                         creator profile + wallet ref
//   users/{uid}/games/{gameId}                          private game template (owner only)
//   users/{uid}/games/{gameId}/runs/{runId}             live run (owner only; CF-written)
//   …/runs/{runId}/teams/{teamId}                       a participating team/individual
//   …/runs/{runId}/{announcements|flashMissions}        live-ops broadcasts (read: any auth)
//   publicGames/{gameId}, publicTasks/{taskId}          denormalized gallery (read: any)
//   wallets/{uid}, wallets/{uid}/transactions/{txId}    credit ledger (owner read only)
//   accessCodes/{code}                                  join codes (any auth read)
//   auditLogs/{id}                                      immutable trail (CF only)
//
// All score/run/team mutations go through Cloud Functions (Admin SDK bypasses
// these rules). Client writes are intentionally narrow.
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny everything not explicitly matched ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── CREATOR PROFILE ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);

      // ── GAME TEMPLATES ─────────────────────────────────────────────────────
      //    Owner-only for both read and write. The builder edits via the
      //    createGame/updateGame callables (Admin SDK) but direct owner writes
      //    are also permitted for responsiveness. publicGames is the read path
      //    for everyone else.
      match /games/{gameId} {
        allow read:  if isOwner(uid);
        allow write: if isOwner(uid);

        // ── RUNS ─────────────────────────────────────────────────────────────
        //    Live instances. Owner reads everything; all writes are CF-only
        //    (score/leaderboard integrity).
        match /runs/{runId} {
          allow read:  if isOwner(uid);
          allow write: if false;

          // ── TEAMS ──────────────────────────────────────────────────────────
          //    A participant (anonymous uid == teamId) reads ONLY their own team
          //    doc for live sync. The owner reads all teams. Writes are CF-only.
          match /teams/{teamId} {
            allow read:  if isOwner(uid) || isOwner(teamId)
                          || isStaffForRun(uid, gameId, runId);
            allow write: if false;
          }

          // ── LIVE-OPS BROADCASTS ────────────────────────────────────────────
          //    Announcements + flash missions are readable by any authenticated
          //    participant in the run; written by Staff via Cloud Functions.
          match /announcements/{docId} {
            allow read:  if isAuthenticated();
            allow write: if false;
          }
          match /flashMissions/{docId} {
            allow read:  if isAuthenticated();
            allow write: if false;
          }

          // ── OPERATIONAL (alerts, locations, staffInvites) ──────────────────
          //    Owner reads; all writes + staff/participant reads go through CFs.
          match /alerts/{docId} {
            allow read:  if isOwner(uid) || isStaffForRun(uid, gameId, runId);
            allow write: if false;
          }
          match /teamLocations/{docId} {
            allow read:  if isOwner(uid);
            allow write: if false;
          }
          match /staffInvites/{docId} {
            allow read:  if isOwner(uid);
            allow write: if false;
          }
        }
      }
    }

    // ── PUBLIC GALLERY (denormalized, read-only to clients) ──────────────────
    match /publicGames/{gameId} {
      allow read:  if true;
      allow write: if false;
    }
    match /publicTasks/{taskId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── WALLETS ──────────────────────────────────────────────────────────────
    match /wallets/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
      match /transactions/{txId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }
    }

    // ── ACCESS CODES ─────────────────────────────────────────────────────────
    //    Any authenticated user may read to validate a code before joining.
    //    The pointer doc ({ownerUid, gameId, runId}) carries no secrets.
    match /accessCodes/{code} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    // ── AUDIT LOGS ───────────────────────────────────────────────────────────
    //    Read only via the listAuditLogs callable (Admin SDK). Closed to clients.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }


    // ═════════════════════════════════════════════════════════════════════════
    // Helpers
    // ═════════════════════════════════════════════════════════════════════════
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Staff signed in via the staffSignIn custom token. The token carries the
    // run scope it was minted for, so staff read is confined to that one run.
    function isStaffForRun(uid, gameId, runId) {
      return request.auth != null
          && request.auth.token.staff == true
          && request.auth.token.ownerUid == uid
          && request.auth.token.gameId == gameId
          && request.auth.token.runId == runId;
    }
  }
}
