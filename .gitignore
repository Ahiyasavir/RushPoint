node_modules/
.env
.env.local
*.env

# Expo
apps/mobile/.expo/
apps/mobile/dist/

# Web app builds
apps/admin/dist/
apps/creator-web/dist/
apps/play-web/dist/
# Playtest builds (--mode playtest). Deliberately a SEPARATE directory from dist/
# so `npm run verify` can never overwrite what the live playtest is serving.
apps/creator-web/dist-playtest/
apps/play-web/dist-playtest/
# tsc --build caches. Machine-local, rewritten by every typecheck; committing one
# makes the next typecheck on another machine read a stale, wrong-path cache.
*.tsbuildinfo

# Firebase
functions/lib/
functions/serviceAccount.json
# Note: .firebaserc is committed — it contains project aliases, no secrets.
# The actual Firebase project ID is also in .env files (gitignored).
# emulator export/import data directory
.firebase/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Shared build
packages/shared/dist/

# Turborepo local cache
.turbo/

# local emulator log
.emulator-log.txt

# Autopilot agent experiment (not part of the product) — tooling + state live on disk only
autopilot/
.autopilot-tooling-snapshot/
.claude/scheduled_tasks.lock

# Playwright UI smoke artifacts
playwright-report/
test-results/
.last-run.json

# ngrok playtest tunnel secrets
.tunnel.env

# Google Play TWA build (Bubblewrap) — signing keystore + build outputs are
# secret / generated; only twa-manifest.json is checked in. See PLAY_STORE.md.
android.keystore
*.keystore
*.jks
*.aab
*.apk
/app/
# The rest of the generated Android project. Bubblewrap writes these at the REPO
# ROOT next to /app/, and `bubblewrap update` rewrites them on every version bump,
# so committing them means a diff on every release that nobody reads. The Gradle
# wrapper is normally checked in for an Android repo, but here it is generated
# alongside /app/ (which is already ignored) rather than authored, so it belongs
# with the rest of the build output. Regenerate with `npm run play:twa:init`.
/build/
/.gradle/
/gradle/
/gradlew
/gradlew.bat
/build.gradle
/settings.gradle
/gradle.properties
/manifest-checksum.txt
/store_icon.png
*.idsig
twa-manifest.json.bak
android.keystore.pub.pem

# Scratch auth tokens from manual callable probing (contain real idTokens) and
# the generated tunnel-redirect staging dir — never commit either.
.tokwork/
tok1.json
call.sh
.hosting-tunnel/
firebase.tunnel.json

# Generated by scripts/emulator-exec.mjs when RUSHPOINT_EMULATOR_PORT_OFFSET is set:
# a copy of firebase.json with the emulator ports shifted, so a gate can run beside a
# live playtest. Must live in the repo root (the Firebase CLI resolves every relative
# path in a --config file against that file's own directory). Never committed.
firebase.emulator-offset.json
