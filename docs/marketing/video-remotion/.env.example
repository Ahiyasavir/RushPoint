# Copy this file to  .env  (same folder) and paste your ElevenLabs API key.
# Get it at: https://elevenlabs.io  →  Profile  →  API Keys  →  Copy
ELEVENLABS_API_KEY=your_key_here

# Optional — pick a specific voice id (default is a warm male multilingual voice "Adam").
# Browse voices at https://elevenlabs.io/app/voice-library  and paste the Voice ID here:
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
