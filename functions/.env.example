# ═══════════════════════════════════════════════════════════
# RushPoint Cloud Functions — Environment Variables
# Copy this file to .env — gitignored.
# These run SERVER-SIDE and may contain secrets.
# ═══════════════════════════════════════════════════════════

# ── Firebase Admin (Application Default Credentials) ─────────────────────────
# When deployed to Cloud Functions, ADC is automatic — no key file needed.
# For LOCAL emulator dev, point to a downloaded service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
#
# Download from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → save as functions/serviceAccount.json (gitignored)

# ── RushPoint App Identity ────────────────────────────────────────────────────
# Must match mobile + admin values
RUSHPOINT_APP_ID=race-to-tzion-2026

# ── Secrets (server-side only — never expose to client) ──────────────────────
# QR code signing secret — used to generate and verify station QR tokens
QR_SECRET=change-me-to-a-long-random-string

# ── Optional: external services ──────────────────────────────────────────────
# Push notifications (Phase 3)
# EXPO_PUSH_TOKEN_SERVER_KEY=
