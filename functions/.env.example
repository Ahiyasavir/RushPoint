# ═══════════════════════════════════════════════════════════
# RushPoint Cloud Functions — server-side environment.
# Copy to functions/.env (gitignored). Firebase deploys .env with the functions,
# so these become process.env.* in production. For real secrets you may instead
# use `firebase functions:secrets:set NAME` (more secure) — see DEPLOY.md.
# ═══════════════════════════════════════════════════════════

# ── Public app URL (used for Stripe success/cancel redirects) ────────────────
# Your deployed creator-web site, e.g. https://rushpoint-creator.web.app
APP_URL=https://rushpoint-creator.web.app

# ── Stripe — collect wallet top-ups (this is how you receive money) ──────────
# From the Stripe Dashboard → Developers → API keys. Use a LIVE secret key
# (sk_live_…) in production, or a TEST key (sk_test_…) while testing.
STRIPE_SECRET_KEY=sk_live_xxx

# Webhook signing secret for the stripeWebhook endpoint. Create a webhook in
# Stripe → Developers → Webhooks pointing at your deployed stripeWebhook URL
# (event: checkout.session.completed), then copy its signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Admin bootstrap allowlist (optional) ─────────────────────────────────────
# Comma-separated UIDs/emails allowed to mint the FIRST admin. Leave unset until
# you know your account's UID, then set it, deploy, promote yourself, and remove.
# RUSHPOINT_ADMIN_BOOTSTRAP=you@example.com

# ── Local emulator only ──────────────────────────────────────────────────────
# In the emulator FUNCTIONS_EMULATOR=true is set automatically and top-ups are
# credited directly (no Stripe needed), so none of the above is required for dev.
