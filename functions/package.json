{
  "name": "@rushpoint/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "npx esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --external:stripe",
    "serve": "npm run build && npx firebase emulators:start --only functions,firestore,auth",
    "deploy": "npm run build && npx firebase deploy --only functions",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@rushpoint/shared": "*",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "stripe": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
