{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "lib",
    "rootDirs": ["src", "../packages/shared/src"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@rushpoint/shared": ["../packages/shared/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
