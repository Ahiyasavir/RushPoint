rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Team photos: authenticated teams can upload to their own folder
    match /checkins/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == teamId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max
        && request.resource.contentType.matches('image/.*');
    }
    // Public photo stream: readable by all authenticated users
    match /stream/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions
    }
  }
}
