rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Team photos: authenticated teams can upload to their own folder
    match /checkins/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == teamId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max
        && request.resource.contentType.matches('image/.*');
    }
    // v2 platform — photo-mission uploads under a run. A participant (uid ==
    // teamId) may write only into their own team folder.
    //
    // READ is restricted: a participant may read only their OWN team's photos,
    // and staff scoped to THIS run may read them for review. The owner + the
    // recap/share surfaces display photos via tokenized getDownloadURL() links
    // (which bypass Storage rules), so this does NOT break legitimate display —
    // it only stops a participant who knows the runId from listing/downloading
    // every other team's photos (faces, locations) by path.
    match /runs/{runId}/teams/{teamId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == teamId
        || (request.auth.token.staff == true && request.auth.token.runId == runId)
      );
      allow write: if request.auth != null && request.auth.uid == teamId
        && request.resource.size < 10 * 1024 * 1024  // 10MB max
        && request.resource.contentType.matches('image/.*');
    }
    // Public photo stream: readable by all authenticated users
    match /stream/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions
    }
  }
}
