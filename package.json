{
    "name": "rushpoint",
    "version": "0.1.0",
    "private": true,
    "packageManager": "npm@11.12.0",
    "workspaces": [
        "apps/creator-web",
        "apps/play-web",
        "functions",
        "packages/shared",
        "scripts"
    ],
    "scripts": {
        "//Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ Cross-repo (Turborepo) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬": "",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "test": "node scripts/run-unit-tests.mjs && turbo run test",
        "test:unit": "node scripts/run-unit-tests.mjs",
        "test:vitest": "turbo run test",
        "bundle:budget": "node scripts/check-bundle-budget.mjs",
        "base:check": "node scripts/check-build-base.mjs",
        "origin:check": "node scripts/check-backend-origin.mjs",
        "verify": "npm run verify:graph && npm run verify:builds && npm run verify:artifacts",
        "verify:emulator": "npm run shared:build && npm run build --workspace=functions && node scripts/emulator-exec.mjs \"node scripts/e2e-verify.mjs\" && node scripts/emulator-exec.mjs --only=firestore,storage \"node scripts/run-rules-suites.mjs\" && node scripts/emulator-exec.mjs \"node scripts/simulate-run.mjs --teams=8\" && node scripts/emulator-exec.mjs \"node scripts/simulate-adversarial.mjs --teams=9 --cheaters=0.5\"",
        "lint:fix": "turbo run lint -- --fix",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
        "//Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬ Individual apps Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬": "",
        "mobile": "npm run dev      --workspace=apps/mobile",
        "mobile:ios": "npm run ios      --workspace=apps/mobile",
        "mobile:android": "npm run android  --workspace=apps/mobile",
        "creator": "npm run dev --workspace=apps/creator-web",
        "creator:build": "npm run build  --workspace=apps/creator-web",
        "play": "npm run dev --workspace=apps/play-web",
        "play:build": "npm run build     --workspace=apps/play-web",
        "play:store:check": "tsx scripts/check-play-store.ts",
        "upload:check": "node scripts/check-upload-health.mjs",
        "upload:check:local": "node scripts/check-upload-health.mjs --origin http://127.0.0.1:8080 --skip-auth",
        "play:assets": "node scripts/gen-play-assets.mjs",
        "play:screenshots": "node scripts/gen-play-screenshots.mjs",
        "play:twa:init": "npx @bubblewrap/cli init --manifest https://rush-point.com/manifest.webmanifest",
        "postplay:twa:init": "node scripts/patch-twa-target-sdk.mjs",
        "preplay:twa:build": "node scripts/patch-twa-target-sdk.mjs",
        "play:twa:build": "npx @bubblewrap/cli build",
        "play:twa:targetsdk": "node scripts/patch-twa-target-sdk.mjs",
        "shared:build": "npm run build    --workspace=packages/shared",
        "dev:tunnel": "concurrently --names PROXY,TUNNEL --prefix-colors cyan,magenta \"node scripts/proxy.mjs\" \"npx cloudflared tunnel --url http://localhost:3000\"",
        "playtest:build": "npm run shared:build && npm run build --workspace=apps/creator-web -- --mode playtest && npm run build --workspace=apps/play-web -- --mode playtest",
        "playtest:creator": "npm run dev --workspace=apps/creator-web -- --host 0.0.0.0 --mode playtest",
        "playtest:play": "npm run dev --workspace=apps/play-web -- --host 0.0.0.0",
        "playtest:creator:dev": "npm run dev --workspace=apps/creator-web -- --host 0.0.0.0 --mode playtest",
        "playtest:play:dev": "npm run dev --workspace=apps/play-web -- --host 0.0.0.0",
        "emulator:backup": "wait-on tcp:127.0.0.1:8080 && node scripts/emulator-backup.mjs",
        "emulator:restore-latest": "node scripts/emulator-backup.mjs --latest",
        "emulator:restore": "node scripts/emulator-restore.mjs",
        "preplaytest": "node scripts/free-ports.mjs",
        "playtest": "concurrently --kill-others-on-fail --names EMU,SEED,BACKUP,CREATOR,PLAY,PROXY,TUNNEL --prefix-colors blue,green,gray,cyan,magenta,white,red \"npm:emulator\" \"npm:dev:seed\" \"npm:emulator:backup\" \"npm:playtest:creator\" \"npm:playtest:play\" \"node scripts/proxy.mjs\" \"npx cloudflared tunnel --url http://localhost:3000\"",
        "preplaytest:ngrok": "node scripts/free-ports.mjs",
        "playtest:ngrok": "concurrently --kill-others-on-fail --names EMU,SEED,BACKUP,CREATOR,PLAY,PROXY,TUNNEL --prefix-colors blue,green,gray,cyan,magenta,white,red \"npm:emulator\" \"npm:dev:seed\" \"npm:emulator:backup\" \"npm:playtest:creator\" \"npm:playtest:play\" \"node scripts/proxy.mjs\" \"node scripts/ngrok-tunnel.mjs\"",
        "playtest:creator:preview": "npm run preview --workspace=apps/creator-web -- --mode playtest --outDir dist-playtest --port 5180 --host 0.0.0.0",
        "playtest:play:preview": "npm run preview --workspace=apps/play-web -- --mode playtest --outDir dist-playtest --port 5181 --host 0.0.0.0",
        "playtest:prod": "concurrently --kill-others-on-fail --names EMU,SEED,BACKUP,CREATOR,PLAY,PROXY,TUNNEL --prefix-colors blue,green,gray,cyan,magenta,white,red \"npm:emulator\" \"npm:dev:seed\" \"npm:emulator:backup\" \"npm:playtest:creator:preview\" \"npm:playtest:play:preview\" \"node scripts/proxy.mjs\" \"node scripts/ngrok-tunnel.mjs\"",
        "hosting:tunnel": "node scripts/hosting-mode.mjs tunnel",
        "hosting:firebase": "node scripts/hosting-mode.mjs firebase",
        "playtest:forever": "node scripts/playtest-forever.mjs",
        "playtest:stop": "node scripts/playtest-forever.mjs --stop",
        "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playtest-autostart.ps1 install",
        "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playtest-autostart.ps1 uninstall",
        "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/playtest-autostart.ps1 status",
        "predev:all:tunnel": "node scripts/free-ports.mjs",
        "dev:all:tunnel": "concurrently --names EMU,SEED,MIRROR,MOBILE,ADMIN,PROXY,TUNNEL --prefix-colors blue,green,yellow,magenta,cyan,white,red \"npm:emulator\" \"npm:dev:seed\" \"npm:dev:mirror\" \"npm:mobile:web\" \"npm:admin\" \"node scripts/proxy.mjs\" \"npx cloudflared tunnel --url http://localhost:3000\"",
        "//Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬ Firebase Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬": "",
        "emulator:export": "firebase emulators:export .firebase/emulator-data",
        "emulator:import": "firebase emulators:start --import=.firebase/emulator-data",
        "functions:serve": "npm run serve --workspace=functions",
        "functions:deploy": "npm run deploy --workspace=functions",
        "//deploy-cost": "COST: each gen-1 function costs ~1 Cloud Build minute; the free tier is 120/DAY. 'deploy:fn <names>' rebuilds ONLY those (cheap, use this). 'deploy:backend' rebuilds ALL ~96 functions and eats the whole daily allowance — a 2nd one that day is billed.",
        "deploy:fn": "node scripts/deploy-functions.mjs",
        "cost:preflight": "node scripts/cost-preflight.mjs",
        "deploy:backend": "echo \"[deploy:backend] EXPENSIVE: rebuilds ALL ~96 functions (~96 Cloud Build minutes = the whole daily free tier). For one changed function use: npm run deploy:fn -- <fnName>\" && firebase deploy --only functions,firestore:rules,firestore:indexes,storage",
        "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
        "deploy:hosting": "npm run shared:build && npm run creator:build && npm run play:build && firebase deploy --only hosting",
        "deploy:all": "npm run deploy:backend && npm run deploy:hosting",
        "//Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬ One-command dev (boots everything in one terminal) Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬": "",
        "//Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬ Dev data Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬Ã¢â€ â‚¬": "",
        "seed": "npm run seed      --workspace=scripts",
        "seed:reset": "npm run seed:reset --workspace=scripts",
        "qa:seed": "node scripts/qa-game.mjs --seed",
        "qa:simulate": "node scripts/qa-game.mjs --simulate",
        "e2e": "node scripts/e2e-verify.mjs",
        "backfill:public-tasks": "node scripts/backfill-public-tasks.mjs",
        "diagnose:task-media": "node scripts/diagnose-task-media.mjs",
        "backfill:seed-templates": "tsx scripts/backfill-seed-templates.mjs",
        "i18n:check": "tsx scripts/check-i18n.ts",
        "i18n:check:strict": "tsx scripts/check-i18n.ts --strict",
        "icons": "node scripts/gen-pwa-icons.mjs",
        "test:rules": "node scripts/test-rules.mjs",
        "test:rules:storage": "node scripts/test-storage-rules.mjs",
        "emails:export": "node scripts/export-emails.mjs",
        "sync": "node scripts/sync-sheets.mjs",
        "push:sheet": "node scripts/push-sheet.mjs",
        "test:ui": "playwright test",
        "test:ui:report": "playwright show-report",
        "simulate": "node scripts/simulate-run.mjs",
        "simulate:browser": "node scripts/simulate-browser-run.mjs",
        "verify:browser": "npm run shared:build && npm run build --workspace=functions && node scripts/emulator-exec.mjs \"node scripts/simulate-browser-run.mjs\"",
        "simulate:adversarial": "node scripts/simulate-adversarial.mjs",
        "simulate:v1": "node scripts/simulate-tournament.mjs",
        "reset:teams": "node scripts/reset-teams.mjs",
        "mirror": "node scripts/mirror.mjs",
        "dev:mirror": "wait-on tcp:127.0.0.1:8080 && node scripts/mirror.mjs",
        "mobile:web": "npm run dev --workspace=apps/mobile -- --web",
        "emulator": "node scripts/dev-emulator.mjs",
        "predev:all": "node scripts/free-ports.mjs",
        "dev:all": "concurrently --names EMU,SEED,CREATOR,PLAY --prefix-colors blue,green,cyan,magenta \"npm:emulator\" \"npm:dev:seed\" \"npm:creator\" \"npm:play\"",
        "dev:seed": "wait-on tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 && node scripts/seed-local.mjs",
        "verify:graph": "turbo run typecheck lint test",
        "verify:builds": "concurrently --group --names CREATOR,PLAY,UNIT,I18N \"npm run creator:build\" \"npm run play:build\" \"node scripts/run-unit-tests.mjs\" \"tsx scripts/check-i18n.ts --strict\"",
        "verify:artifacts": "concurrently --group --names BUNDLE,BASE,ORIGIN \"node scripts/check-bundle-budget.mjs\" \"node scripts/check-build-base.mjs\" \"node scripts/check-backend-origin.mjs\"",
        "test:rules:both": "node scripts/run-rules-suites.mjs"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^7.14.0",
        "@typescript-eslint/parser": "^7.14.0",
        "ajv": "^8.20.0",
        "@bubblewrap/cli": "1.24.1",
        "cloudflared": "^0.7.1",
        "concurrently": "^9.1.0",
        "eslint": "^8.57.0",
        "http-proxy": "^1.18.1",
        "localtunnel": "^2.0.2",
        "prettier": "^3.3.0",
        "sharp": "^0.35.2",
        "turbo": "^2.0.0",
        "typescript": "^5.4.0",
        "wait-on": "^8.0.1"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@expo/metro-runtime": "~4.0.1",
        "react-dom": "18.3.1",
        "react-native-web": "~0.19.13"
    }
}
